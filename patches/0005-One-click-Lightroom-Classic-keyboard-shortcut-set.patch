+/// The user's own bindings sit above either set: a key given to another command wins over the
+/// set's, a removed shortcut stays removed, and ↺ (reset) restores the set's key.
+#[test]
+fn user_bindings_still_win_over_the_set() {
+    let mut h = demo();
+    set_profile(&mut h, "classic");
+    run(&mut h, "app.setShortcut", json!({"id": "view.survey", "shortcut": "E"}));
+    let sel = h.app.session.visible_cloned().into_iter().take(2).map(|id| id.0).collect::<Vec<_>>();
+    run(&mut h, "library.select", json!({"ids": sel, "active": sel[0]}));
+    h.app.ui.view = ViewMode::PhotoGrid;
+    h.step();
+    press(&mut h, "E", &[]);
+    assert_eq!(h.app.ui.view, ViewMode::Survey, "the user's E is Survey, not the Loupe");
+    assert_eq!(shortcut_of(KeyProfile::Classic, &h.app.ui.settings.keymap, "view.detail"), None);
+    // the user's removal of a set's key: R does nothing
+    run(&mut h, "app.setShortcut", json!({"id": "panel.crop", "shortcut": null}));
+    reset_view(&mut h);
+    press(&mut h, "R", &[]);
+    assert_eq!(h.app.ui.right, RightPanel::None, "a removed shortcut stays removed");
+    assert!(h.app.ui.tool.is_empty());
+    // and a user key carries across a switch of sets
+    set_profile(&mut h, "lightroom");
+    assert_eq!(shortcut_of(KeyProfile::Lightroom, &h.app.ui.settings.keymap, "view.survey"), Some("E"));
+    assert_eq!(shortcut_of(KeyProfile::Lightroom, &h.app.ui.settings.keymap, "panel.edit"), None, "Lightroom's E yields to it");
+    // reset restores the active set's key, not the declared one
+    let mut km = Keymap::new();
+    shortcuts::assign(KeyProfile::Classic, &mut km, "view.detail", Some("F9")).unwrap();
+    assert_eq!(shortcut_of(KeyProfile::Classic, &km, "view.detail"), Some("F9"));
+    shortcuts::reset(KeyProfile::Classic, &mut km, "view.detail").unwrap();
+    assert_eq!(shortcut_of(KeyProfile::Classic, &km, "view.detail"), Some("E"));
+    assert!(km.is_empty(), "the set's own key is not saved as a change");
+    // a key the set gave another command is taken from it when the user claims it
+    let lost = shortcuts::assign(KeyProfile::Classic, &mut km, "view.survey", Some("R")).unwrap();
+    assert_eq!(lost, ["panel.crop"]);
+}
