diff --git a/crates/ui-egui/src/tests/classic_keymap.rs b/crates/ui-egui/src/tests/classic_keymap.rs
new file mode 100644
index 000000000..4bfee45c3
--- /dev/null
+++ b/crates/ui-egui/src/tests/classic_keymap.rs
@@ -0,0 +1,479 @@
+//! The Lightroom Classic shortcut set (LightCraft additional extensions; Help ▸ Keyboard Shortcuts
+//! ▸ Shortcut set, `app.keyProfile`): switching it changes what the keys fire, the user's own
+//! bindings still win, the set has no clashing keys, and the choice is saved in `ui.json`
+//! (a file from before it existed reads as Lightroom).
+
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use egui::{Key, Modifiers};
+use serde_json::{Value, json};
+
+use crate::headless::Headless;
+use crate::keymap_profiles::{CLASSIC_ALIASES, CLASSIC_DROPPED_ALIASES, CLASSIC_OVERRIDES, KeyProfile, aliases, profile_default};
+use crate::shortcuts::{self, ALIASES, CONTEXTUAL, Keymap, bindable, binding, find_bindable, parse, shortcut_of};
+use crate::state::{AppSettings, Dialog, RightPanel, ViewMode};
+use crate::{LightcraftApp, Services};
+
+const T: Duration = Duration::from_secs(20);
+const SETTLE: Duration = Duration::from_secs(120);
+
+/// The demo library in the Detail view; `editors` records the editor each Edit In asks for (and
+/// refuses it, so nothing is rendered).
+fn demo_with(editors: Arc<Mutex<Vec<String>>>) -> Headless {
+    let services = Services {
+        png: None,
+        open_with: Some(Box::new(|_: &str, _: &str| Ok(()))),
+        check_editor: Some(Box::new(move |app: &str| {
+            if let Ok(mut v) = editors.lock() {
+                v.push(app.to_string());
+            }
+            Err("not in this test".into())
+        })),
+        ..Default::default()
+    };
+    let app = LightcraftApp::new(lightcraft_engine::Session::with_demo(), services);
+    let mut h = Headless::new(app, [1400.0, 900.0], 1.0);
+    let r = h.request("ui.set", json!({"view": "detail"}), T);
+    assert_eq!(r["ok"], true, "{r}");
+    h.settle(SETTLE);
+    h
+}
+
+fn demo() -> Headless {
+    demo_with(Arc::default())
+}
+
+/// Press `k` with the modifiers named in `mods` (`cmd`, `alt`, `shift`, `ctrl`).
+fn press(h: &mut Headless, k: &str, mods: &[&str]) {
+    let mut p = json!({"key": k});
+    for m in mods {
+        p[*m] = json!(true);
+    }
+    let r = h.request("ui.key", p, T);
+    assert_eq!(r["ok"], true, "{r}");
+    h.step();
+    h.step();
+}
+
+fn run(h: &mut Headless, id: &str, params: Value) -> Value {
+    let r = h.app.run(id, params);
+    h.step();
+    h.step();
+    r.unwrap_or_else(|e| panic!("{id}: {e}"))
+}
+
+fn set_profile(h: &mut Headless, profile: &str) {
+    assert_eq!(run(h, "app.keyProfile", json!({"profile": profile}))["profile"], profile);
+}
+
+/// Back to the Detail view with no panel or tool open.
+fn reset_view(h: &mut Headless) {
+    h.app.ui.dialog = None;
+    h.app.ui.right = RightPanel::None;
+    h.app.ui.tool.clear();
+    h.app.ui.view = ViewMode::Detail;
+    h.step();
+    h.step();
+}
+
+/// The commands the key `sc` belongs to under `profile` with the user's `keymap`.
+fn owners(profile: KeyProfile, keymap: &Keymap, sc: &str) -> Vec<&'static str> {
+    let key = parse(sc);
+    bindable().iter().filter(|b| binding(profile, keymap, b.id, b.default).and_then(parse) == key).map(|b| b.id).collect()
+}
+
+/// A key as Windows and Linux read it: Cmd is the Ctrl key there, so ⌘Y and Ctrl+Y are one press.
+fn windows_key(sc: &str) -> Option<(Modifiers, Key)> {
+    parse(sc).map(|(mut m, k)| {
+        if m.ctrl {
+            m.ctrl = false;
+            m.command = true;
+        }
+        (m, k)
+    })
+}
+
+/// Every pair of keys that would act on one press under `profile` with no saved shortcuts: two
+/// commands (other than contextual partners), an active secondary key and a command, two active
+/// secondary keys. A pair with a key the Classic set gives is also compared the way Windows reads
+/// keys (Cmd = Ctrl), so Classic's Ctrl+Y can't meet a ⌘Y. (The shipped ⌘⇧H Histogram and
+/// Ctrl+⇧H HDR with Last Settings are one press on Windows in either set; Classic leaves both.)
+fn clashes(profile: KeyProfile) -> Vec<String> {
+    let keymap = Keymap::new();
+    let classic_ids: Vec<&str> = CLASSIC_OVERRIDES.iter().map(|(id, _)| *id).collect();
+    // (key, key as Windows reads it, what has it, whether the Classic set gave it)
+    let mut keys: Vec<((Modifiers, Key), (Modifiers, Key), String, bool)> = Vec::new();
+    for b in bindable() {
+        if let Some(sc) = binding(profile, &keymap, b.id, b.default)
+            && let (Some(k), Some(w)) = (parse(sc), windows_key(sc))
+        {
+            keys.push((k, w, b.id.to_string(), profile == KeyProfile::Classic && classic_ids.contains(&b.id)));
+        }
+    }
+    for (sc, id, _) in aliases(profile) {
+        let (Some(k), Some(w)) = (parse(sc), windows_key(sc)) else { panic!("alias {sc}") };
+        let classic = profile == KeyProfile::Classic && CLASSIC_ALIASES.iter().any(|(a, _, _)| a == sc);
+        keys.push((k, w, format!("alias {sc} ({id})"), classic));
+    }
+    let mut out = Vec::new();
+    for (i, (k, w, a, ca)) in keys.iter().enumerate() {
+        for (k2, w2, b, cb) in &keys[i + 1..] {
+            let contextual = CONTEXTUAL.iter().any(|(x, y)| (x == a && y == b) || (x == b && y == a));
+            if (k == k2 || ((*ca || *cb) && w == w2)) && !contextual {
+                out.push(format!("{a} and {b}"));
+            }
+        }
+    }
+    out
+}
