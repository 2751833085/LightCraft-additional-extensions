+/// Classic's ⌘N is New Album in the Library and Create Version while editing; the menus show the
+/// key on the one it runs.
+#[test]
+fn classic_cmd_n_follows_the_module() {
+    let mut h = demo();
+    set_profile(&mut h, "classic");
+    let active = h.app.session.active().expect("the demo has an active photo");
+    let versions = |h: &Headless| h.app.session.catalog.photo(active).map_or(0, |p| p.versions.len());
+    let entry = |h: &Headless, id: &str| crate::menus::menubar::menu_bar(&h.app).into_iter().any(|(_, nodes)| has_key(&nodes, id));
+    h.app.ui.view = ViewMode::PhotoGrid;
+    h.step();
