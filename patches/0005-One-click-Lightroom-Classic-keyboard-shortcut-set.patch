+/// No two keys act on one press in the Classic set (nor in the shipped one, checked the same way).
+#[test]
+fn the_classic_set_has_no_conflicting_bindings() {
+    assert_eq!(clashes(KeyProfile::Classic), Vec::<String>::new());
+    assert_eq!(clashes(KeyProfile::Lightroom), Vec::<String>::new());
+    // and no Classic key takes a fixed key (ratings, labels, the grids' navigation and B)
+    let fixed: Vec<String> = (0..=9)
+        .flat_map(|n| [n.to_string(), format!("Shift+{n}")])
+        .chain(["Home", "End", "Shift+Left", "Shift+Right", "B", "Enter"].map(String::from))
+        .collect();
+    for (id, sc) in CLASSIC_OVERRIDES {
+        assert!(!fixed.iter().any(|f| parse(f) == parse(sc)), "{id}: {sc} is a fixed key");
+    }
+}
