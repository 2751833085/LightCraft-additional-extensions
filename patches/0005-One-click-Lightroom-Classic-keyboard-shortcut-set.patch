+    press(&mut h, "C", &[]);
+    assert_eq!(h.app.ui.right, RightPanel::Crop, "Lightroom: C opens Crop");
+    reset_view(&mut h);
+    press(&mut h, "R", &[]);
+    assert_eq!(h.app.ui.tool, "radial", "Lightroom: R is the Radial Gradient");
+    reset_view(&mut h);
+    h.app.ui.view = ViewMode::PhotoGrid;
+    h.step();
+    press(&mut h, "D", &[]);
+    assert_eq!(h.app.ui.view, ViewMode::Detail, "Lightroom: D is the Detail view");
+    assert_eq!(h.app.ui.right, RightPanel::None);
+
+    let keymap_before = h.app.ui.settings.keymap.clone();
+    set_profile(&mut h, "classic");
+    assert_eq!(h.app.ui.settings.keymap, keymap_before, "the set doesn't rewrite the user's keymap");
+    // Classic: E the Loupe (Detail view), D Develop (Detail + Edit), C Compare, R Crop
+    reset_view(&mut h);
+    h.app.ui.view = ViewMode::PhotoGrid;
+    h.step();
+    press(&mut h, "E", &[]);
+    assert_eq!((h.app.ui.view, h.app.ui.right), (ViewMode::Detail, RightPanel::None), "Classic: E is the Loupe");
+    h.app.ui.view = ViewMode::PhotoGrid;
+    h.step();
+    press(&mut h, "D", &[]);
+    assert_eq!((h.app.ui.view, h.app.ui.right), (ViewMode::Detail, RightPanel::Edit), "Classic: D is Develop");
+    reset_view(&mut h);
+    press(&mut h, "R", &[]);
+    assert_eq!(h.app.ui.right, RightPanel::Crop, "Classic: R opens Crop");
+    assert!(h.app.ui.tool.is_empty(), "and not the Radial Gradient");
+    reset_view(&mut h);
+    let sel = h.app.session.visible_cloned().into_iter().take(2).map(|id| id.0).collect::<Vec<_>>();
+    run(&mut h, "library.select", json!({"ids": sel, "active": sel[0]}));
+    press(&mut h, "C", &[]);
+    assert_eq!(h.app.ui.view, ViewMode::Compare, "Classic: C is Compare");
+    assert_eq!(h.app.ui.right, RightPanel::None, "and not Crop");
+    // ⌘⌥2 stays the Develop module
+    reset_view(&mut h);
+    h.app.ui.view = ViewMode::PhotoGrid;
+    h.step();
+    press(&mut h, "2", &["cmd", "alt"]);
+    assert_eq!((h.app.ui.view, h.app.ui.right), (ViewMode::Detail, RightPanel::Edit), "Classic: ⌘⌥2 is Develop");
+}
