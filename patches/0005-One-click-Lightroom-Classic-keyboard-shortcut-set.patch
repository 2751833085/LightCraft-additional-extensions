+/// The Classic table names real commands with keys that parse, never repeats a shipped key, and
+/// leaves the grid rows' own keys alone (the native menu reads those from the shipped set).
+#[test]
+fn the_classic_table_is_well_formed() {
+    let mut wrong: Vec<String> = Vec::new();
+    for (id, sc) in CLASSIC_OVERRIDES {
+        let Some(b) = find_bindable(id) else {
+            wrong.push(format!("unknown command {id}"));
+            continue;
+        };
+        if !sc.is_empty() && parse(sc).is_none() {
+            wrong.push(format!("{id}: `{sc}` doesn't parse"));
+        }
+        let shipped = profile_default(KeyProfile::Lightroom, id, b.default);
+        if sc.is_empty() && shipped.is_none() {
+            wrong.push(format!("{id}: removes a key it hasn't got"));
+        } else if !sc.is_empty() && shipped.and_then(parse) == parse(sc) {
+            wrong.push(format!("{id}: `{sc}` is already the shipped key"));
+        }
+        if matches!(*id, "view.photoGrid" | "view.squareGrid") {
+            wrong.push(format!("{id}: the native menu reads the grid rows' keys from the shipped set"));
+        }
+    }
+    for (sc, id, params) in CLASSIC_ALIASES {
+        if find_bindable(id).is_none() || parse(sc).is_none() || serde_json::from_str::<Value>(params).is_err() {
+            wrong.push(format!("alias {sc} ({id}) {params}"));
+        }
+    }
+    for sc in CLASSIC_DROPPED_ALIASES {
+        if !ALIASES.iter().any(|(a, _, _)| a == sc) {
+            wrong.push(format!("dropped alias {sc} is not a shipped alias"));
+        }
+    }
+    assert!(wrong.is_empty(), "{}", wrong.join("; "));
+}
