+/// Whether a menu row for `id` shows a key.
+fn has_key(nodes: &[crate::menus::menubar::MenuNode], id: &str) -> bool {
+    use crate::menus::menubar::MenuNode;
+    nodes.iter().any(|n| match n {
+        MenuNode::Item { id: i, shortcut, .. } => i == id && shortcut.is_some(),
+        MenuNode::Submenu { children, .. } => has_key(children, id),
+        MenuNode::Separator => false,
+    })
+}
