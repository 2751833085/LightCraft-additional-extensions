+    h.app.ui.dialog = None;
+    run(&mut h, "module.develop", json!({}));
+    press(&mut h, "N", &["cmd"]);
+    assert!(h.app.ui.dialog.is_none(), "Develop: no album dialog");
+    assert_eq!(versions(&h), 1, "Develop: ⌘N makes a version (a snapshot)");
+    assert!(!entry(&h, "dialog.newAlbum") && entry(&h, "version.create"), "the menu shows ⌘N on Create Version");
+}
