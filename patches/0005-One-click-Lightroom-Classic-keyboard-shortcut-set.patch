+/// What the keys resolve to under each set: Lightroom Classic's E / D / C / R / ⌘E / ⌘⇧E.
+#[test]
+fn each_set_resolves_its_own_keys() {
+    let km = Keymap::new();
+    let lr = |sc| owners(KeyProfile::Lightroom, &km, sc);
+    let lrc = |sc| owners(KeyProfile::Classic, &km, sc);
+    assert_eq!(lr("E"), ["panel.edit"]);
+    assert_eq!(lr("D"), ["view.detail"]);
+    assert_eq!(lr("C"), ["panel.crop"]);
+    assert_eq!(lr("R"), ["tool.radial"]);
+    assert_eq!(lr("Cmd+Shift+E"), ["photo.editInPhotoCraft"]);
+    assert!(lr("Cmd+E").is_empty(), "Lightroom's ⌘E is the Export with Previous alias");
+    assert_eq!(lrc("E"), ["view.detail"]);
+    assert_eq!(lrc("D"), ["module.develop"]);
+    assert_eq!(lrc("C"), ["view.compare"]);
+    assert_eq!(lrc("R"), ["panel.crop"]);
+    assert_eq!(lrc("Cmd+E"), ["photo.editInExternal"]);
+    assert_eq!(lrc("Cmd+Shift+E"), ["dialog.export"]);
+    assert_eq!(lrc("Cmd+Alt+E"), ["photo.editInPhotoCraft"]);
+    for (sc, id) in [
+        ("G", "view.gridToggle"),
+        ("N", "view.survey"),
+        ("Q", "panel.remove"),
+        ("K", "tool.brush"),
+        ("M", "tool.linear"),
+        ("Shift+M", "tool.radial"),
+        ("Shift+W", "panel.masking"),
+        ("L", "view.lightsOut"),
+        ("I", "view.infoOverlay"),
+        ("H", "view.toolOverlay"),
+        ("Shift+T", "tool.guidedUpright"),
+        ("Cmd+Shift+S", "develop.sync"),
+        ("Cmd+U", "develop.auto"),
+        ("Cmd+Alt+Shift+E", "app.exportPrevious"),
+        ("Cmd+Alt+1", "module.library"),
+        ("Cmd+Alt+6", "module.print"),
+    ] {
+        assert_eq!(lrc(sc), [id], "{sc}");
+    }
+    // ⌘N: a new album in the Library, a new version (snapshot) while editing
+    assert_eq!(lrc("Cmd+N"), ["dialog.newAlbum", "version.create"]);
+    // the Classic secondary keys, and the shipped ones its own keys replace
+    let active: Vec<&str> = aliases(KeyProfile::Classic).map(|(sc, _, _)| *sc).collect();
+    for sc in ["Shift+P", "Cmd+I", "Cmd+Alt+2", "Ctrl+Y", "Shift+X", "Cmd+D"] {
+        assert!(active.contains(&sc), "{sc}");
+    }
+    assert!(!active.contains(&"Cmd+E") && !active.contains(&"Shift+M"));
+    assert_eq!(aliases(KeyProfile::Lightroom).count(), ALIASES.len(), "the shipped set keeps every secondary key");
+}
