diff --git a/crates/ui-egui/src/keymap_profiles.rs b/crates/ui-egui/src/keymap_profiles.rs
new file mode 100644
index 000000000..27cfb21bf
--- /dev/null
+++ b/crates/ui-egui/src/keymap_profiles.rs
@@ -0,0 +1,127 @@
+//! Shortcut sets (LightCraft additional extensions, adapted from upstream PR #2338): which set of
+//! default shortcuts the commands use.
+//!
+//! `Lightroom` (the default) is the keymap LightCraft has always shipped: the Lightroom-desktop
+//! keys with Classic additions. `Classic` gives the same commands Lightroom Classic's defaults
+//! where LightCraft has the command (E Loupe, D Develop, C Compare, R Crop, Q Spot Removal,
+//! K Brush, M / ⇧M gradients, ⌘⇧E Export…), so Classic muscle memory works in one click: Help ▸
+//! Keyboard Shortcuts ▸ Shortcut set, Settings ▸ General ▸ Keyboard, or `app.keyProfile`. The
+//! user's own bindings (`AppSettings::keymap`) sit above whichever set is active. The full
+//! mapping, and the Classic keys LightCraft has no command for, are in `docs/classic-keymap.md`.
+
+use serde::{Deserialize, Serialize};
+
+/// A set of default shortcuts. Saved in `ui.json` as `settings.keyProfile`; a file without it (or
+/// with a value this build doesn't know) reads as [`KeyProfile::Lightroom`].
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub enum KeyProfile {
+    /// The shipped keymap (Lightroom-desktop keys with Classic additions).
+    #[default]
+    Lightroom,
+    /// Lightroom Classic's defaults.
+    Classic,
+}
+
+impl KeyProfile {
+    pub const ALL: [KeyProfile; 2] = [KeyProfile::Lightroom, KeyProfile::Classic];
+
+    /// The id `app.keyProfile` takes and returns, and the one `ui.json` saves.
+    pub const fn id(self) -> &'static str {
+        match self {
+            KeyProfile::Lightroom => "lightroom",
+            KeyProfile::Classic => "classic",
+        }
+    }
+
+    /// The set an id names (`app.keyProfile {profile}`); `None` for an unknown one.
+    pub fn from_id(id: &str) -> Option<KeyProfile> {
+        KeyProfile::ALL.into_iter().find(|p| p.id() == id)
+    }
+
+    /// The English name the selectors show, the key of its translation.
+    pub const fn label(self) -> &'static str {
+        match self {
+            KeyProfile::Lightroom => "Lightroom (default)",
+            KeyProfile::Classic => "Lightroom Classic",
+        }
+    }
+}
+
+/// The Classic set's defaults: `(command id, shortcut)`; `""` removes the declared one. Every key
+/// another command declares moves too, so the set has no clashes (see the `classic_keymap` tests).
+pub const CLASSIC_OVERRIDES: &[(&str, &str)] = &[
+    // Library views: E Loupe, D Develop, C Compare, L Lights Out, I info overlay (G grid and N
+    // Survey are already Classic's). The Edit panel's E goes to the Loupe; D is the module.
+    ("view.detail", "E"),
+    ("panel.edit", ""),
+    ("module.develop", "D"),
+    ("view.compare", "C"),
+    ("view.lightsOut", "L"),
+    ("view.infoOverlay", "I"),
+    ("panel.info", ""),
+    // Develop tools: R Crop, Q Spot Removal, K Brush, M Linear, ⇧M Radial, ⇧W Masking,
+    // ⇧T Guided Upright, H shows / hides the pins (the tool overlay)
+    ("panel.crop", "R"),
+    ("panel.remove", "Q"),
+    ("tool.brush", "K"),
+    ("panel.keywords", ""),
+    ("tool.linear", "M"),
+    ("tool.radial", "Shift+M"),
+    ("panel.masking", "Shift+W"),
+    ("tool.guidedUpright", "Shift+T"),
+    ("view.toolOverlay", "H"),
+    ("view.maskOverlayMode", "Alt+O"),
+    // ⇧P flags Pick and advances (a Classic alias below), so Presets has no key
+    ("panel.presets", ""),
+    // Develop settings: ⌘U Auto, ⌘⇧S Sync Settings, ⌘⌥⇧M Match Total Exposures
+    ("develop.auto", "Cmd+U"),
+    ("develop.sync", "Cmd+Shift+S"),
+    ("develop.matchExposure", "Cmd+Alt+Shift+M"),
+    // ⌘N: a new snapshot (version) while editing, a new album (collection) in the Library;
+    // ⌘⇧N likewise a new preset or a new folder (`shortcuts::CONTEXTUAL`)
+    ("version.create", "Cmd+N"),
+    ("dialog.createPreset", "Cmd+Shift+N"),
+    // ⌘⇧E Export…, ⌘E Edit in the other editor (Photoshop), ⌘⌥E Edit in PhotoCraft
+    // (⌘⌥⇧E Export with Previous is already Classic's)
+    ("dialog.export", "Cmd+Shift+E"),
+    ("photo.editInExternal", "Cmd+E"),
+    ("photo.editInPhotoCraft", "Cmd+Alt+E"),
+];
+
+/// Secondary keys only the Classic set adds: `(shortcut, command id, params)`.
+pub const CLASSIC_ALIASES: &[(&str, &str, &str)] = &[
+    // ⇧P flags Pick and advances everywhere, not only in the grids
+    ("Shift+P", "photo.flag", r#"{"flag": "pick", "advance": true}"#),
+    // I cycles the info overlay; ⌘I (Ctrl+I on Windows) too
+    ("Cmd+I", "view.infoOverlay", "{}"),
+    // Develop is D, and stays on the module key ⌘⌥2 (Ctrl+Alt+2 on Windows)
+    ("Cmd+Alt+2", "module.develop", "{}"),
+    // Windows' second Redo key
+    ("Ctrl+Y", "edit.redo", "{}"),
+];
+
+/// The shipped secondary keys ([`crate::shortcuts::ALIASES`]) the Classic set drops, because one
+/// of its own defaults has the key: ⌘E (Export with Previous, which keeps ⌘⌥⇧E) is Edit in the
+/// other editor and ⇧M (Create Version, now ⌘N) the Radial Gradient.
+pub const CLASSIC_DROPPED_ALIASES: &[&str] = &["Cmd+E", "Shift+M"];
+
+/// The shortcut command `id` has under `profile` when the user hasn't changed it: the Classic
+/// table first (`""` in it means none), else the declared default.
+pub fn profile_default(profile: KeyProfile, id: &str, declared: Option<&'static str>) -> Option<&'static str> {
+    if profile == KeyProfile::Classic
+        && let Some((_, sc)) = CLASSIC_OVERRIDES.iter().find(|(o, _)| *o == id)
+    {
+        return if sc.is_empty() { None } else { Some(sc) };
+    }
+    declared
+}
+
+/// The secondary keys active under `profile`: `(shortcut, command id, params)`.
+pub fn aliases(profile: KeyProfile) -> impl Iterator<Item = &'static (&'static str, &'static str, &'static str)> {
+    let classic = profile == KeyProfile::Classic;
+    crate::shortcuts::ALIASES
+        .iter()
+        .filter(move |(sc, _, _)| !(classic && CLASSIC_DROPPED_ALIASES.contains(sc)))
+        .chain(CLASSIC_ALIASES.iter().filter(move |_| classic))
+}
