+/// `Y` and its variants: in the Detail view, toggle that Before / After layout. Elsewhere (a grid,
+/// Compare, Survey, Reference, the Print module) open the photo in the Detail view with the layout
+/// on, as Lightroom Classic's `Y` in Library goes to Develop's Before / After: in Compare the select,
+/// else the active photo. Only the Detail view draws Before / After, so the layout set behind
+/// another view did nothing on screen.
+fn before_after_view(app: &mut LightcraftApp, mode: BeforeAfter) -> Result<Value, String> {
+    if app.ui.view == ViewMode::Detail && !crate::panels::modules::print_active(app) {
+        app.ui.before_after = if app.ui.before_after == mode { BeforeAfter::Off } else { mode };
+        return Ok(Value::Null);
+    }
+    let photo = if app.ui.view == ViewMode::Compare {
+        crate::panels::compare::compare_pair(app).map(|(select, _)| select).or_else(|| app.session.active())
+    } else {
+        app.session.active()
+    };
+    let Some(id) = photo else { return Err("Before/After needs a photo: select one first".into()) };
+    if app.ui.view == ViewMode::Compare {
+        // the select alone, as the Detail view opened from Compare shows it
+        app.session.execute("library.select", &json!({"ids": [id.0], "active": id.0})).map_err(|e| e.to_string())?;
+    }
+    crate::panels::modules::switch(app, crate::panels::modules::Module::Develop)?;
+    app.ui.view = ViewMode::Detail;
+    app.ui.before_after = mode;
+    Ok(json!({"photo": id.0}))
+}
