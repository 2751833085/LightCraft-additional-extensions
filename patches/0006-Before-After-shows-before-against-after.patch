+//! Before / After shows before against after: the Before view never shows the edited photo while
+//! its own render is on its way (#2248), `Y` from a grid or Compare opens the Detail view's Before /
+//! After, a wipe names its sides, and Copy Before's Settings to After keeps the frame shown.
+
+use std::cell::Cell;
+use std::rc::Rc;
+use std::time::Duration;
+
+use serde_json::{Value, json};
+
+use crate::headless::{Headless, RenderGate};
+use crate::render::Slot;
+use crate::state::{BeforeAfter, ViewMode};
+use crate::{LightcraftApp, Services};
+
+const T: Duration = Duration::from_secs(20);
+const SETTLE: Duration = Duration::from_secs(120);
+
+fn demo() -> Headless {
+    let app = LightcraftApp::new(lightcraft_engine::Session::with_demo(), Services { png: None, ..Default::default() });
+    Headless::new(app, [1400.0, 900.0], 1.0)
+}
+
+fn ok(h: &mut Headless, method: &str, params: Value) -> Value {
+    let r = h.request(method, params, T);
+    assert_eq!(r["ok"], true, "{method}: {r}");
+    r
+}
+
+fn cmd(h: &mut Headless, id: &str, params: Value) -> Value {
+    ok(h, "engine.execute", json!({"command": id, "params": params}))
+}
+
+fn has(h: &Headless, widget: &str) -> bool {
+    h.app.widgets.iter().any(|(w, _)| w == widget)
+}
+
+fn count(h: &Headless, text: &str) -> usize {
+    h.painted_text().iter().filter(|t| t.as_str() == text).count()
+}
+
+/// The demo's third photo, edited (brighter), open in the Detail view without the filmstrip, with
+/// its Before render held back. Returns the photo and the gate's latch.
+fn edited_photo_before_render_held(fails_before: bool) -> (Headless, lightcraft_catalog::PhotoId, Rc<Cell<bool>>) {
+    let mut h = demo();
+    // the grid first: its thumbnails are the stand-ins a Before view must not borrow
+    h.settle(SETTLE);
+    let id = h.app.session.visible_cloned()[2];
+    cmd(&mut h, "library.select", json!({"ids": [id.0], "active": id.0}));
+    ok(&mut h, "ui.set", json!({"view": "detail", "right": "none", "filmstrip": false}));
+    cmd(&mut h, "develop.set", json!({"control": "light.exposure", "value": 1.5}));
+    assert!(h.settle(SETTLE), "the edited photo renders");
+    let open = Rc::new(Cell::new(fails_before));
+    let gate = if fails_before { RenderGate::failing(open.clone(), |s| s == Slot::Before) } else { RenderGate::new(open.clone()) };
+    h.app.renderer.set_offload(Box::new(gate));
+    (h, id, open)
+}
+
+fn before_rendered(h: &Headless, id: lightcraft_catalog::PhotoId) -> bool {
+    h.app.renderer.textures.get(&Slot::Before).is_some_and(|t| t.photo == id)
+}
+
+/// The stand-ins (preview, thumbnail) show the photo's current settings: they stand in for the
+/// Before view only while those are its before settings.
+#[test]
+fn the_before_view_takes_a_stand_in_only_when_it_looks_the_same() {
+    use crate::panels::detail::stand_in_shows;
+    let mut app = LightcraftApp::new(lightcraft_engine::Session::with_demo(), Services { png: None, ..Default::default() });
+    let id = app.session.visible_cloned()[0];
+    app.session.execute("library.select", &json!({"ids": [id.0], "active": id.0})).unwrap();
+    app.session.execute("beforeAfter.setBefore", &json!({"source": "current"})).unwrap();
+    assert!(stand_in_shows(&app, id, Slot::Before), "settings = before settings: the stand-in looks the same");
+    app.session.execute("develop.set", &json!({"control": "light.exposure", "value": 1.5})).unwrap();
+    assert!(!stand_in_shows(&app, id, Slot::Before), "edited: the stand-in would show the edits");
+    assert!(stand_in_shows(&app, id, Slot::Main), "the After view still uses the stand-in");
+}
+
+/// #2248: Show Original (`\`) of an edited photo whose Before render is not there yet showed the
+/// thumbnail, the edited photo, under the Before label. Now a neutral frame says the Before is
+/// rendering, until the Before render replaces it.
+#[test]
+fn show_original_never_shows_the_edited_stand_in() {
+    let (mut h, id, open) = edited_photo_before_render_held(false);
+    assert!(h.app.renderer.thumb(id).is_some(), "a stand-in the Before view could have borrowed");
+    h.app.ui.before_after = BeforeAfter::Original;
+    for _ in 0..5 {
+        h.step();
+    }
+    assert!(!before_rendered(&h, id), "no Before render of the photo yet");
+    assert_eq!(h.app.loupe_shown, Some((id, "none")), "nothing of the edited photo is drawn as the Before");
+    assert!(has(&h, "canvas:beforeRendering"), "the neutral frame is up");
+    assert_eq!(count(&h, crate::i18n::tr("Rendering before…")), 1, "it says the Before is rendering");
+    assert!(has(&h, "canvas:beforeLabel"), "under the Before label");
+    open.set(true);
+    assert!(h.step_until(SETTLE, |h| before_rendered(h, id)), "the Before render lands");
+    h.settle(SETTLE);
+    assert_eq!(h.app.loupe_shown, Some((id, "render")));
+    assert!(!has(&h, "canvas:beforeRendering"), "the frame gives way to the Before render");
+}
+
+/// Side by side and in a wipe, the Before side of an edited photo shows the neutral frame (not the
+/// After, or nothing over the After of a wipe) until its render arrives.
+#[test]
+fn the_before_side_waits_in_a_neutral_frame_in_every_layout() {
+    let (mut h, id, open) = edited_photo_before_render_held(false);
+    for mode in [BeforeAfter::SideBySide, BeforeAfter::TopBottom, BeforeAfter::Split, BeforeAfter::SplitTopBottom] {
+        h.app.ui.before_after = mode;
+        for _ in 0..5 {
+            h.step();
+        }
+        assert!(!before_rendered(&h, id), "{mode:?}: no Before render yet");
+        assert!(has(&h, "canvas:beforeRendering"), "{mode:?}: the Before side is the neutral frame");
+        assert_eq!(count(&h, crate::i18n::tr("Rendering before…")), 1, "{mode:?}: it says why");
+        let frame = h.app.widgets.iter().find(|(w, _)| w == "canvas:beforeRendering").map(|(_, r)| *r).expect("frame");
+        let after = h.app.image_rect.expect("the After view");
+        match mode {
+            // a wipe: the frame covers the Before side of the line only
+            BeforeAfter::Split => assert!(frame.right() <= after.center().x + 1.0, "{mode:?}: {frame:?} left of the line in {after:?}"),
+            BeforeAfter::SplitTopBottom => assert!(frame.bottom() <= after.center().y + 1.0, "{mode:?}: {frame:?} above the line in {after:?}"),
+            // two panes: the frame is in the Before pane, clear of the After view
+            _ => assert!(!frame.intersects(after), "{mode:?}: {frame:?} beside the After view {after:?}"),
+        }
+    }
+    open.set(true);
+    assert!(h.step_until(SETTLE, |h| before_rendered(h, id)), "the Before render lands");
+    h.settle(SETTLE);
+    assert!(!has(&h, "canvas:beforeRendering"), "the frame gives way to the Before render");
+}
+
+/// A Before render that fails says so in the Before view instead of leaving it empty.
+#[test]
+fn a_failed_before_render_says_so() {
+    let (mut h, id, _open) = edited_photo_before_render_held(true);
+    h.app.ui.before_after = BeforeAfter::Original;
+    assert!(h.step_until(SETTLE, |h| h.app.renderer.failure_of(Slot::Before, id).is_some()), "the Before render fails");
+    h.settle(SETTLE);
+    assert!(has(&h, "canvas:beforeRendering"), "the neutral frame stays");
+    assert_eq!(count(&h, crate::i18n::tr("The before view can't be rendered")), 1, "it names the failure");
+    assert_eq!(count(&h, "no decoder for this raw"), 1, "and its reason");
+}
+
+/// A wipe names its sides as side by side does: Before and After under (or, stacked, over) the photo.
+#[test]
+fn a_wipe_labels_before_and_after() {
+    let mut h = demo();
+    ok(&mut h, "ui.set", json!({"view": "detail", "right": "none", "filmstrip": false}));
+    h.settle(SETTLE);
+    let (before, after) = (crate::i18n::tr("Before").to_string(), crate::i18n::tr("After").to_string());
+    let plain = (count(&h, &before), count(&h, &after));
+    for mode in [BeforeAfter::Split, BeforeAfter::SplitTopBottom, BeforeAfter::SideBySide] {
+        h.app.ui.before_after = mode;
+        h.settle(SETTLE);
+        assert_eq!((count(&h, &before), count(&h, &after)), (plain.0 + 1, plain.1 + 1), "{mode:?}: one Before and one After label");
+    }
+}
+
+/// `Y` in Compare (or a click on the bottom bar's Before/After button there) opens the select in the
+/// Detail view with Before and After side by side, as Lightroom Classic's `Y` in Library goes to
+/// Develop's Before / After. The button used to light up and change nothing on screen.
+#[test]
+fn y_in_compare_opens_the_select_in_before_after() {
+    for by_button in [false, true] {
+        let mut h = demo();
+        h.settle(SETTLE);
+        let ids: Vec<u64> = h.app.session.visible_cloned().into_iter().take(2).map(|id| id.0).collect();
+        cmd(&mut h, "library.select", json!({"ids": ids, "active": ids[0]}));
+        let r = cmd(&mut h, "view.compare", json!({}));
+        let select = r["result"]["select"].as_u64().expect("a select");
+        h.settle(SETTLE);
+        assert_eq!(h.app.ui.view, ViewMode::Compare);
+        if by_button {
+            assert!(has(&h, "icon:beforeAfter"), "Compare shows the Before/After button");
+            ok(&mut h, "ui.clickWidget", json!({"id": "icon:beforeAfter"}));
+        } else {
+            ok(&mut h, "ui.key", json!({"key": "Y"}));
+        }
+        h.settle(SETTLE);
+        assert_eq!(h.app.ui.view, ViewMode::Detail, "by_button {by_button}: the Detail view");
+        assert_eq!(h.app.ui.before_after, BeforeAfter::SideBySide, "by_button {by_button}: with Before and After");
+        assert_eq!(h.app.session.active().map(|id| id.0), Some(select), "of the select");
+        assert!(has(&h, "canvas:image"), "the photo is on screen");
+    }
+}
+
+/// `Y`, `Shift`+`Y` and `Alt`+`Y` in a grid open the active photo in the Detail view with that
+/// layout instead of setting it unseen; in the Detail view they still toggle it.
+#[test]
+fn y_in_a_grid_opens_the_detail_view_with_that_layout() {
+    for (params, mode) in [
+        (json!({"key": "Y"}), BeforeAfter::SideBySide),
+        (json!({"key": "Y", "shift": true}), BeforeAfter::Split),
+        (json!({"key": "Y", "alt": true}), BeforeAfter::TopBottom),
+    ] {
+        let mut h = demo();
+        h.settle(SETTLE);
+        let id = h.app.session.visible_cloned()[1];
+        cmd(&mut h, "library.select", json!({"ids": [id.0], "active": id.0}));
+        ok(&mut h, "ui.set", json!({"view": "photoGrid"}));
+        h.settle(SETTLE);
+        ok(&mut h, "ui.key", params.clone());
+        h.settle(SETTLE);
+        assert_eq!(h.app.ui.view, ViewMode::Detail, "{params}: the Detail view");
+        assert_eq!(h.app.ui.before_after, mode, "{params}");
+        assert_eq!(h.app.session.active(), Some(id), "{params}: of the active photo");
+        // in the Detail view the key toggles the layout off again
+        ok(&mut h, "ui.key", params.clone());
+        h.settle(SETTLE);
+        assert_eq!((h.app.ui.view, h.app.ui.before_after), (ViewMode::Detail, BeforeAfter::Off), "{params}: toggled off");
+    }
+}
+
+/// Copy Before's Settings to After gives the photo what the Before view showed: its before look
+/// with the current crop (the Before view always uses it), not the import state's uncropped frame.
+#[test]
+fn copy_before_to_after_keeps_the_crop_shown() {
+    let mut h = demo();
+    let id = h.app.session.visible_cloned()[0];
+    cmd(&mut h, "library.select", json!({"ids": [id.0], "active": id.0}));
+    cmd(&mut h, "develop.set", json!({"control": "light.exposure", "value": 1.5}));
+    cmd(&mut h, "crop.set", json!({"rect": [0.1, 0.1, 0.9, 0.9]}));
+    let photo = h.app.session.catalog.photo(id).expect("photo");
+    let (crop, shown) = (photo.develop.crop, h.app.session.before_settings(photo));
+    cmd(&mut h, "beforeAfter.copyBeforeToAfter", json!({}));
+    let d = h.app.session.catalog.photo(id).expect("photo").develop.clone();
+    assert_eq!(d.crop, crop, "the crop stays");
+    assert_eq!(d.light.exposure, shown.light.exposure, "the before look");
+}
