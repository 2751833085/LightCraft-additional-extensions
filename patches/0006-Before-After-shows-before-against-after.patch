+/// Where the loupe's views go.
+struct ViewPlaces<'a> {
+    id: PhotoId,
+    ppp: f32,
+    mode: ViewMode,
+    img_rect: Rect,
+    before_img: Rect,
+    areas: &'a [Rect],
+    main_area: Rect,
+    canvas: Rect,
+    /// A wipe's line.
+    line: Pos2,
+    /// The hovered look's label, while one is hovered.
+    hover: Option<&'a str>,
+    badge_top_inset: f32,
+}
+
+/// What the loupe's whole-frame views drew.
+struct DrawnViews {
+    /// What shows the photo ("render", a stand-in's name, "hover", "none").
+    shown: &'static str,
+    /// Show Original's Before label, painted once the window renders are down (they would cover it).
+    before_badge: Option<(Rect, std::sync::Arc<egui::Galley>)>,
+    /// Where the Before view has nothing that shows the before settings yet: the neutral frame that
+    /// says so, never the edited photo under the Before label (#2248).
+    before_placeholder: Option<Rect>,
+}
+
+/// Draw the whole-frame views of the layout: Before and After side by side or stacked, the Before
+/// alone (Show Original), the hovered look, or the After, and a wipe's Before side.
+fn draw_views(app: &LightcraftApp, p: &egui::Painter, t: &Tokens, v: &ViewPlaces) -> DrawnViews {
+    let draw = |slot: Slot, r: Rect, clip: Rect| draw_slot(app, p, v.id, v.ppp, slot, r, clip);
+    let (img_rect, canvas, id) = (v.img_rect, v.canvas, v.id);
+    let mut out = DrawnViews { shown: "none", before_badge: None, before_placeholder: None };
+    if v.mode.split {
+        // each view stays in its pane: zoomed in, a photo reaches past it (and would cover the
+        // other view's margins with its whole-frame render, magnified and blurred)
+        let (br, pane) = (v.before_img, v.areas.first().copied().unwrap_or(canvas));
+        if draw(Slot::Before, br, pane) == "none" {
+            out.before_placeholder = Some(draw_before_placeholder(app, p, t, id, br, pane));
+        }
+        out.shown = draw(Slot::Main, img_rect, v.main_area);
+        split_labels(p, t, [(br, pane), (img_rect, v.main_area)]);
+    } else if v.mode.show_before {
+        out.shown = draw(Slot::Before, img_rect, canvas);
+        if out.shown == "none" {
+            out.before_placeholder = Some(draw_before_placeholder(app, p, t, id, img_rect, canvas));
+        }
+        // on the photo itself, so it gets a dark pill to stay readable over light pictures;
+        // painted after the window renders, which would cover it zoomed in
+        let g = p.layout_no_wrap(crate::i18n::tr("Before").to_string(), t.semibold(14.0), Color32::WHITE);
+        out.before_badge = Some((label_badge_rect(img_rect, canvas, g.size(), v.badge_top_inset), g));
+    } else if let Some(label) = v.hover
+        && let Some(tex) = app.renderer.textures.get(&Slot::Hover).filter(|t| t.photo == id)
+    {
+        draw_hover(p, t, tex, label, [img_rect, canvas], v.badge_top_inset);
+        out.shown = "hover";
+    } else {
+        out.shown = draw(Slot::Main, img_rect, canvas);
+        if out.shown == "none" {
+            none_message(app, p, t, canvas, id);
+        }
+    }
+    // a wipe shows the Before whole-frame render on its side of the line (the window renders go
+    // over the whole-frame ones, on their side of it)
+    if !v.mode.split && !v.mode.show_before {
+        out.before_placeholder = draw_wipe_before(app, p, t, id, [img_rect, canvas], v.line);
+    }
+    out
