+/// Copy Before's Settings to After and Swap give the photo what the Before view shows: the before
+/// settings with the current crop and orientation (the Before view always uses those), not the
+/// raw before settings, which dropped the crop and the rotation of a photo set to its import state.
+#[test]
+fn copy_before_to_after_and_swap_keep_the_current_crop_and_orientation() {
+    let mut s = demo();
+    let id = s.active().unwrap();
+    let import = s.catalog.photo(id).unwrap().import_defaults();
+    s.execute("develop.set", &json!({"values": {"light.exposure": 1.5}})).unwrap();
+    s.execute("crop.set", &json!({"rect": [0.1, 0.1, 0.9, 0.9]})).unwrap();
+    s.execute("photo.rotateRight", &json!({})).unwrap();
+    let (crop, orientation) = (active_dev(&s).crop, active_dev(&s).orientation);
+    assert_ne!(crop, import.crop, "the crop is an edit");
+    assert_ne!(orientation, import.orientation, "the rotation is an edit");
+    let shown = s.before_settings(s.catalog.photo(id).unwrap());
+    s.execute("beforeAfter.copyBeforeToAfter", &json!({})).unwrap();
+    let d = active_dev(&s);
+    assert_eq!(d.light.exposure, import.light.exposure, "the before look");
+    assert_eq!((d.crop, d.orientation), (crop, orientation), "the crop and orientation stay");
+    assert_eq!(d, shown, "the photo is what the Before view showed");
+    // swap: the same, and the old settings become the before
+    s.execute("edit.undo", &json!({})).unwrap();
+    assert_eq!(active_dev(&s).light.exposure, 1.5);
+    s.execute("beforeAfter.swap", &json!({})).unwrap();
+    let d = active_dev(&s);
+    assert_eq!(d.light.exposure, import.light.exposure);
+    assert_eq!((d.crop, d.orientation), (crop, orientation), "a swap keeps the crop and orientation");
+    assert_eq!(s.before_settings(s.catalog.photo(id).unwrap()).light.exposure, 1.5);
+}
