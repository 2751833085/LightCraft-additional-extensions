+    assert_eq!(h.app.ui.right, RightPanel::Edit);
+    // the view underneath: its key still leaves Print
+    cmd(&mut h, "module.print", json!({}));
+    cmd(&mut h, "view.detail", json!({}));
+    assert!(!modules::print_active(&h.app));
+    // File > Print… shares the print settings: it closes the module first
+    cmd(&mut h, "module.print", json!({}));
+    cmd(&mut h, "dialog.print", json!({}));
+    assert!(matches!(h.app.ui.dialog, Some(Dialog::Print)) && !modules::print_active(&h.app));
+    assert!(!has(&h, "panel:printModule"));
