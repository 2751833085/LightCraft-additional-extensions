+#[test]
+fn the_bar_folds_before_it_reaches_the_search_field() {
+    for width in [900.0, 1024.0, 1200.0, 1280.0, 1600.0] {
+        let app = LightcraftApp::new(lightcraft_engine::Session::with_demo(), Services::default());
+        let mut h = Headless::new(app, [width, 800.0], 1.0);
+        h.settle(T);
+        let rect = |h: &Headless, id: &str| h.app.widgets.iter().find(|(w, _)| w == id).map(|(_, r)| *r);
+        let bar = rect(&h, "region:moduleBar").expect("the module bar");
+        for other in ["icon:filter", "field:search"] {
+            let r = rect(&h, other).unwrap_or_else(|| panic!("{other} at {width}"));
+            assert!(!bar.intersects(r), "{width} pt: the module bar {bar:?} over {other} {r:?}");
+        }
+        let folded = has(&h, "combo:module");
+        assert_eq!(folded, !has(&h, "button:module-print"), "{width} pt: one form or the other");
+        if width >= 1600.0 {
+            assert!(!folded, "a wide window shows the four buttons");
+        }
+        if folded {
+            // the drop-down still switches modules
+            click(&mut h, "combo:module");
+            click(&mut h, "button:module-print");
+            assert!(modules::print_active(&h.app), "{width} pt");
+        }
+    }
+}
