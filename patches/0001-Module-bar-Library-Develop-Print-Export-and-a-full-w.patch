diff --git a/crates/ui-egui/src/panels/modules.rs b/crates/ui-egui/src/panels/modules.rs
new file mode 100644
index 000000000..69190ffd0
--- /dev/null
+++ b/crates/ui-egui/src/panels/modules.rs
@@ -0,0 +1,282 @@
+//! The module bar (LightCraft additional extensions): Library | Develop | Print | Export at the
+//! right of the top bar, the way Lightroom Classic switches modules.
+//!
+//! The modules map onto what the app already has, and the way each works stays Lightroom's:
+//! Library is the photo grid with the left panel, Develop the detail view with the Edit panel,
+//! Print fills the window with the print settings and the page preview
+//! ([`crate::panels::print_module`]) and Export opens the Export dialog. The engine, the panels'
+//! content and the library are not changed.
+
+use egui::{Rect, Sense, pos2, vec2};
+use serde_json::{Value, json};
+
+use crate::LightcraftApp;
+use crate::state::{Dialog, RightPanel, ViewMode};
+use crate::theme::Tokens;
+use crate::widgets::register;
+
+/// The translation context of the module names: Develop reads 修改照片 here, not the 编辑 it
+/// reads elsewhere.
+pub const MODULE_CONTEXT: &str = "module";
+
+/// A module of the bar.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Module {
+    Library,
+    Develop,
+    Print,
+    Export,
+}
+
+impl Module {
+    pub const ALL: [Module; 4] = [Module::Library, Module::Develop, Module::Print, Module::Export];
+
+    /// The id used for the bar's widgets (`button:module-<id>`) and its command (`module.<id>`).
+    pub fn id(self) -> &'static str {
+        match self {
+            Module::Library => "library",
+            Module::Develop => "develop",
+            Module::Print => "print",
+            Module::Export => "export",
+        }
+    }
+
+    /// The English name, the key of its translation in [`MODULE_CONTEXT`].
+    pub fn label(self) -> &'static str {
+        match self {
+            Module::Library => "Library",
+            Module::Develop => "Develop",
+            Module::Print => "Print",
+            Module::Export => "Export",
+        }
+    }
+
+    /// The command that switches to the module.
+    pub fn command(self) -> &'static str {
+        match self {
+            Module::Library => "module.library",
+            Module::Develop => "module.develop",
+            Module::Print => "module.print",
+            Module::Export => "module.export",
+        }
+    }
+
+    /// The module a `module.*` command switches to.
+    pub fn from_command(id: &str) -> Option<Module> {
+        Module::ALL.into_iter().find(|m| m.command() == id)
+    }
+
+    /// The name shown on the bar, in the UI language.
+    pub fn name(self) -> &'static str {
+        crate::i18n::tr_ctx(MODULE_CONTEXT, self.label())
+    }
+}
+
+/// What the module bar remembers between frames (never saved: the app opens where Lightroom's
+/// views left it, and the Print module is left on quit).
+#[derive(Clone, Debug, Default)]
+pub struct ModuleState {
+    /// The Print module fills the window.
+    pub print: bool,
+    /// The view and right panel when the Print module opened: a view or panel command run from
+    /// it (a shortcut, a menu) leaves the Print module for what it asked for.
+    pub print_from: Option<(ViewMode, RightPanel)>,
+    /// What the long-edge print layout was last built for ([`crate::panels::print_module`]).
+    pub long_edge_built: Option<String>,
+    /// The last long-edge layout had to shrink photos to fit the printable area.
+    pub long_edge_scaled: bool,
+    /// The last long-edge layout could not be built: why.
+    pub long_edge_error: Option<String>,
+    /// The photos the last long-edge layout holds, one page each: what Print to PDF prints.
+    pub long_edge_ids: Vec<lightcraft_catalog::PhotoId>,
+    /// Selected photos the last long-edge layout left out (no size, or too small to print).
+    pub long_edge_skipped: usize,
+    /// The print settings before the Print module laid out its long-edge pages: given back when
+    /// the module closes or Size by long edge is turned off, so File ▸ Print… and `print.*`
+    /// print what they printed before (the module's pages pin their photos).
+    pub print_saved: Option<lightcraft_engine::print::template::PrintSettings>,
+}
+
+/// Whether the Print module fills the window this frame.
+pub fn print_active(app: &LightcraftApp) -> bool {
+    app.ui.modules.print
+}
+
+/// The module the window is showing.
+pub fn current(app: &LightcraftApp) -> Module {
+    if matches!(app.ui.dialog, Some(Dialog::Export { .. })) {
+        Module::Export
+    } else if app.ui.modules.print {
+        Module::Print
+    } else if matches!(app.ui.view, ViewMode::PhotoGrid | ViewMode::SquareGrid | ViewMode::People) {
+        Module::Library
+    } else {
+        Module::Develop
+    }
+}
+
+/// Once a frame, before anything draws: a view or right-panel change made while the Print module
+/// was open (a shortcut such as G or D, a menu item) leaves the Print module.
+pub fn before_frame(app: &mut LightcraftApp) {
+    let m = &app.ui.modules;
+    if m.print && m.print_from.is_some_and(|from| from != (app.ui.view, app.ui.right)) {
+        leave_print(app);
+    }
+}
+
+/// Switch to `module` (the `module.*` commands and the bar's buttons).
+pub fn switch(app: &mut LightcraftApp, module: Module) -> Result<Value, String> {
+    match module {
+        Module::Library => {
+            leave_print(app);
+            if !matches!(app.ui.view, ViewMode::PhotoGrid | ViewMode::SquareGrid) {
+                app.ui.view = ViewMode::PhotoGrid;
+            }
+            app.ui.left_panel = true;
+            // the develop tools belong to Develop; Info and Keywords stay beside the grid
+            if app.ui.right.is_edit_tool() {
+                end_tool(app);
+                app.ui.right = RightPanel::None;
+            }
+        }
+        Module::Develop => {
+            leave_print(app);
+            if !matches!(app.ui.view, ViewMode::Detail | ViewMode::Reference) {
+                app.ui.view = ViewMode::Detail;
+            }
+            // an edit tool already open (Crop, Masking, Remove…) stays; anything else shows Edit
+            if !app.ui.right.is_edit_tool() {
+                end_tool(app);
+                app.ui.right = RightPanel::Edit;
+            }
+        }
+        Module::Print => {
+            if !app.ui.modules.print {
+                end_tool(app);
+                app.ui.print = Default::default();
+                app.ui.modules.print = true;
+                app.ui.modules.print_from = Some((app.ui.view, app.ui.right));
+                // built again for the photos selected now
+                crate::panels::print_module::forget_layout(app);
+            }
+        }
+        Module::Export => return app.run("dialog.export", json!({})),
+    }
+    Ok(json!({"module": module.id()}))
+}
+
+/// Leave the Print module, giving back the print layout it replaced; whether it was open.
+pub(crate) fn leave_print(app: &mut LightcraftApp) -> bool {
+    if !app.ui.modules.print {
+        return false;
+    }
+    app.ui.modules.print = false;
+    app.ui.modules.print_from = None;
+    crate::panels::print_module::restore_layout(app);
+    true
+}
+
+/// End a tool in use the way a panel change does (the white-balance picker stays armed).
+fn end_tool(app: &mut LightcraftApp) {
+    if app.ui.tool != "wbPicker" {
+        app.ui.tool.clear();
+    }
+    let _ = app.session.end_interaction();
+}
+
+/// Horizontal padding inside a module button, points.
+const PAD: f32 = 10.0;
+/// Room between two module buttons, points.
+const GAP: f32 = 2.0;
+/// Height of a module button, points.
+const HEIGHT: f32 = 26.0;
+
+fn font(t: &Tokens) -> egui::FontId {
+    t.semibold(13.0)
+}
+
+/// The width the bar takes, to plan the top bar before drawing it.
+pub fn bar_width(ui: &egui::Ui) -> f32 {
+    let t = Tokens::get(ui.ctx());
+    Module::ALL.iter().map(|m| button_width(ui, &t, *m)).sum::<f32>() + GAP * (Module::ALL.len() as f32 - 1.0)
+}
+
+fn button_width(ui: &egui::Ui, t: &Tokens, m: Module) -> f32 {
+    ui.painter().layout_no_wrap(m.name().to_string(), font(t), t.text).size().x + 2.0 * PAD
+}
+
+/// The tooltip of a module button: its name and the key it is bound to now.
+fn tip(app: &LightcraftApp, ui: &egui::Ui, m: Module) -> String {
+    let mac = ui.ctx().os() == egui::os::OperatingSystem::Mac;
+    match crate::shortcuts::shortcut_of(&app.ui.settings.keymap, m.command()) {
+        Some(sc) => format!("{} ({})", m.name(), crate::menubar::shortcut_text(sc, mac)),
+        None => m.name().to_string(),
+    }
+}
+
+/// The width of the folded bar: one drop-down holding the current module's name.
+pub fn compact_width(ui: &egui::Ui) -> f32 {
+    let t = Tokens::get(ui.ctx());
+    Module::ALL.iter().map(|m| button_width(ui, &t, *m)).fold(0.0, f32::max) + 28.0
+}
+
+/// Draw the bar with its right edge at `right`, centred on `cy`; returns its left edge. `compact`
+/// folds it into one drop-down, for a window too narrow for the four buttons and the search field.
+pub fn show(app: &mut LightcraftApp, ui: &mut egui::Ui, right: f32, cy: f32, compact: bool) -> f32 {
+    let t = Tokens::get(ui.ctx());
+    let active = current(app);
+    let mut clicked = None;
+    let left = if compact {
+        let w = compact_width(ui);
+        let r = Rect::from_min_size(pos2(right - w, cy - HEIGHT / 2.0), vec2(w, HEIGHT));
+        register(ui, "region:moduleBar", r);
+        let mut child = ui.new_child(egui::UiBuilder::new().max_rect(r).layout(egui::Layout::left_to_right(egui::Align::Center)));
+        let combo = craft_ui::ComboBox::from_id_salt("module-bar-compact").width(w - 4.0).selected_text(active.name()).show_ui(&mut child, |ui| {
+            for m in Module::ALL {
+                let resp = ui.selectable_label(m == active, m.name()).on_hover_text(tip(app, ui, m));
+                register(ui, format!("button:module-{}", m.id()), resp.rect);
+                if resp.clicked() {
+                    clicked = Some(m);
+                }
+            }
+        });
+        crate::widgets::name_combo(&combo.response, active.name());
+        register(ui, "combo:module", combo.response.rect);
+        r.left()
+    } else {
+        let widths: Vec<f32> = Module::ALL.iter().map(|m| button_width(ui, &t, *m)).collect();
+        let total = widths.iter().sum::<f32>() + GAP * (widths.len() as f32 - 1.0);
+        let left = right - total;
+        register(ui, "region:moduleBar", Rect::from_min_size(pos2(left, cy - HEIGHT / 2.0), vec2(total, HEIGHT)));
+        let mut x = left;
+        for (m, w) in Module::ALL.iter().copied().zip(widths) {
+            let r = Rect::from_min_size(pos2(x, cy - HEIGHT / 2.0), vec2(w, HEIGHT));
+            let resp = ui.interact(r, egui::Id::unique(("module-bar", m.id())), Sense::click());
+            let on = m == active;
+            resp.widget_info(|| egui::WidgetInfo::selected(egui::Role::Button, true, on, m.name()));
+            let resp = resp.on_hover_text(tip(app, ui, m));
+            register(ui, format!("button:module-{}", m.id()), r);
+            let painter = ui.painter();
+            if on {
+                painter.rect_filled(r, 4.0, t.pressed);
+                let line = Rect::from_min_max(pos2(r.left() + PAD, r.bottom() - 2.0), pos2(r.right() - PAD, r.bottom()));
+                painter.rect_filled(line, 1.0, t.accent);
+            } else if resp.hovered() {
+                painter.rect_filled(r, 4.0, t.hover);
+            }
+            let colour = if on || resp.hovered() { t.text } else { t.text_dim };
+            painter.text(r.center(), egui::Align2::CENTER_CENTER, m.name(), font(&t), colour);
+            if resp.clicked() {
+                clicked = Some(m);
+            }
+            x += w + GAP;
+        }
+        left
+    };
+    if let Some(m) = clicked
+        && let Err(e) = app.run(m.command(), json!({}))
+    {
+        app.toast_error(ui.ctx(), e);
+    }
+    left
+}
diff --git a/crates/ui-egui/src/panels/print_module.rs b/crates/ui-egui/src/panels/print_module.rs
new file mode 100644
index 000000000..dced8cf6e
--- /dev/null
+++ b/crates/ui-egui/src/panels/print_module.rs
@@ -0,0 +1,304 @@
+//! The Print module (LightCraft additional extensions): the module bar's Print fills the window
+//! with the page preview in the middle and the print settings on the right, the way Lightroom
+//! Classic's Print module is laid out.
+//!
+//! Photo Size ▸ Size by long edge (on by default, 10 in): each selected photo prints on its own
+//! page, centred, at the chosen long edge and its own cropped aspect ratio. Only the print layout
+//! changes (through the `print.*` commands, a Custom Package of one cell per page); the photo, its
+//! edits and the library are not touched. The print layout it replaced is given back when the
+//! module closes or Size by long edge is turned off ([`restore_layout`]), so File ▸ Print… prints
+//! what it printed before. Turned off, the print layout styles (Single, Contact, Package, Custom)
+//! and every other print setting of the Print dialog are shown instead.
+
+use egui::{RichText, Ui};
+use lightcraft_catalog::PhotoId;
+use lightcraft_engine::print::layout::{self, Style, Unit};
+use serde_json::json;
+
+use crate::LightcraftApp;
+use crate::print_view::{self, check, heading, length, ptr, row};
+use crate::theme::Tokens;
+use crate::widgets::{register, text_button};
+
+/// Width of the settings column, points.
+const SETTINGS_W: f32 = 330.0;
+/// The long edge a photo can be given, inches.
+pub const MIN_LONG_EDGE_IN: f64 = 1.0;
+pub const MAX_LONG_EDGE_IN: f64 = layout::MAX_PAGE_IN;
+/// Long edges offered as buttons, inches.
+const QUICK_SIZES: [f64; 6] = [5.0, 6.0, 8.0, 10.0, 12.0, 16.0];
+
+/// The size, inches, of a photo `photo_w` x `photo_h` (any unit) printed with its long edge at
+/// `long_edge` in an area `area_w` x `area_h` in: `(width, height, shrunk)`, `shrunk` when the
+/// area could not take it and it was scaled down, aspect ratio kept. `None` for sizes that are
+/// not positive and finite, or a result smaller than a print cell can be.
+pub fn cell_size(photo_w: f64, photo_h: f64, long_edge: f64, area_w: f64, area_h: f64) -> Option<(f64, f64, bool)> {
+    let ok = |v: f64| v.is_finite() && v > 0.0;
+    if !(ok(photo_w) && ok(photo_h) && ok(long_edge) && ok(area_w) && ok(area_h)) {
+        return None;
+    }
+    let (w, h) = if photo_w >= photo_h { (long_edge, long_edge * photo_h / photo_w) } else { (long_edge * photo_w / photo_h, long_edge) };
+    let scale = (area_w / w).min(area_h / h).min(1.0);
+    let (w, h) = (w * scale, h * scale);
+    (w >= layout::MIN_CELL_IN && h >= layout::MIN_CELL_IN).then_some((w, h, scale < 1.0 - 1e-9))
+}
+
+/// Photo `id`'s size as it prints: the developed size, its crop and rotation included.
+fn photo_size(app: &LightcraftApp, id: PhotoId) -> Option<(f64, f64)> {
+    let p = app.session.catalog.photo(id)?;
+    let (w, h) = lightcraft_pipeline::native_output_size(p.width.max(1) as usize, p.height.max(1) as usize, &p.develop);
+    (w.is_finite() && h.is_finite() && w > 0.0 && h > 0.0).then_some((w, h))
+}
+
+/// The selected photos (what File ▸ Print… prints).
+fn selection(app: &LightcraftApp) -> Vec<PhotoId> {
+    app.session.targets(&json!({})).unwrap_or_default()
+}
+
+/// The photos the module prints: with Size by long edge, the ones laid out (at most a layout's
+/// pages); without it, the selection, as File ▸ Print… prints it.
+fn print_photos(app: &LightcraftApp) -> Vec<PhotoId> {
+    if app.ui.settings.print_by_long_edge { app.ui.modules.long_edge_ids.clone() } else { selection(app) }
+}
+
+/// Forget what the long-edge layout was built for, so the next frame builds it again.
+pub(crate) fn forget_layout(app: &mut LightcraftApp) {
+    let m = &mut app.ui.modules;
+    m.long_edge_built = None;
+    m.long_edge_error = None;
+    m.long_edge_scaled = false;
+    m.long_edge_ids.clear();
+    m.long_edge_skipped = 0;
+}
+
+/// Give back the print layout and image settings the long-edge pages replaced; the page setup and
+/// print job changed in the module (paper, orientation, margins, profile…) are kept.
+pub(crate) fn restore_layout(app: &mut LightcraftApp) {
+    forget_layout(app);
+    if let Some(saved) = app.ui.modules.print_saved.take() {
+        let print = &mut app.session.print;
+        let page = print.layout.page.clone();
+        print.layout = saved.layout;
+        print.layout.page = page;
+        print.image = saved.image;
+    }
+}
+
+/// Keep the print layout one centred long-edge cell per photo while Size by long edge is on:
+/// built again when the photos, their crops, the long edge, the printable area or the grid
+/// change, or when something else changed the layout's style or image border.
+pub fn sync_long_edge(app: &mut LightcraftApp) {
+    if !app.ui.settings.print_by_long_edge {
+        return;
+    }
+    let long = app.ui.settings.print_long_edge_in.clamp(MIN_LONG_EDGE_IN, MAX_LONG_EDGE_IN);
+    let area = match app.session.print.layout.printable() {
+        Ok(area) => area,
+        Err(e) => {
+            forget_layout(app);
+            app.ui.modules.long_edge_error = Some(e);
+            return;
+        }
+    };
+    let ids = selection(app);
+    let sizes: Vec<(PhotoId, Option<(f64, f64)>)> = ids.iter().map(|id| (*id, photo_size(app, *id))).collect();
+    // the grid takes part: switching to the custom style validates it against the printable area
+    let mut key = format!("{long:.4}|{:.4},{:.4},{:.4},{:.4}|{:?}|", area.x, area.y, area.w, area.h, app.session.print.layout.grid);
+    for (id, size) in &sizes {
+        let (w, h) = size.unwrap_or_default();
+        key.push_str(&format!("{}:{:.1}x{:.1};", id.0, w, h));
+    }
+    let print = &app.session.print;
+    let laid_out = print.layout.style == Style::CustomPackage && !print.image.border_enabled;
+    let failed = app.ui.modules.long_edge_error.is_some();
+    if (laid_out || failed) && app.ui.modules.long_edge_built.as_deref() == Some(key.as_str()) {
+        return;
+    }
+    if app.ui.modules.print_saved.is_none() {
+        app.ui.modules.print_saved = Some(app.session.print.clone());
+    }
+    let built = build(app, &sizes, long, area);
+    let m = &mut app.ui.modules;
+    match built {
+        Ok((laid, skipped, shrunk)) => {
+            m.long_edge_ids = laid;
+            m.long_edge_skipped = skipped;
+            m.long_edge_scaled = shrunk;
+            m.long_edge_error = None;
+        }
+        Err(e) => {
+            m.long_edge_ids.clear();
+            m.long_edge_skipped = 0;
+            m.long_edge_scaled = false;
+            m.long_edge_error = Some(e);
+        }
+    }
+    // built (or failed) for this: not tried again until something it depends on changes
+    m.long_edge_built = Some(key);
+}
+
+/// Lay the photos out, one centred cell per page: the photos laid out, how many were left out
+/// (no size, too small, past a layout's pages) and whether any had to shrink to fit.
+fn build(app: &mut LightcraftApp, sizes: &[(PhotoId, Option<(f64, f64)>)], long: f64, area: layout::Rect) -> Result<(Vec<PhotoId>, usize, bool), String> {
+    // a package border would draw inside the cell and print the photo smaller than its long edge
+    app.run(
+        "print.set",
+        json!({"layout": {"style": "customPackage"}, "image": {"zoomToFill": false, "rotateToFit": false, "borderEnabled": false}}),
+    )?;
+    app.run("print.layout.clear", json!({}))?;
+    let mut laid = Vec::new();
+    let mut shrunk = false;
+    for (id, size) in sizes {
+        if laid.len() >= layout::MAX_PAGES as usize {
+            break;
+        }
+        let Some((w, h, small)) = size.and_then(|(pw, ph)| cell_size(pw, ph, long, area.w, area.h)) else { continue };
+        shrunk |= small;
+        let page = laid.len() as u32;
+        if page > 0 {
+            app.run("print.layout.newPage", json!({}))?;
+        }
+        let added = app.run("print.cell.add", json!({"width": w, "height": h}))?;
+        let cell = added["id"].as_u64().ok_or("print.cell.add returned no cell")?;
+        app.run("print.cell.page", json!({"id": cell, "page": page}))?;
+        app.run("print.cell.move", json!({"id": cell, "x": area.x + (area.w - w) / 2.0, "y": area.y + (area.h - h) / 2.0}))?;
+        app.run("print.cell.photo", json!({"id": cell, "photo": id.0}))?;
+        laid.push(*id);
+    }
+    let skipped = sizes.len() - laid.len();
+    Ok((laid, skipped, shrunk))
+}
+
+fn fmt_len(inches: f64, unit: Unit) -> String {
+    let decimals = if unit == Unit::Points { 0 } else { 2 };
+    format!("{:.*} {}", decimals, unit.from_inches(inches), unit.label())
+}
+
+/// Photo Size: Size by long edge, the long edge, and what the first photo prints at.
+fn size_section(app: &mut LightcraftApp, ui: &mut Ui, t: &Tokens) {
+    heading(ui, t, "Photo Size");
+    if let Some(v) = check(ui, "printByLongEdge", "Size by long edge", app.ui.settings.print_by_long_edge) {
+        app.ui.settings.print_by_long_edge = v;
+        // off: the layout the long-edge pages replaced comes back, to change with the layout styles
+        restore_layout(app);
+    }
+    if !app.ui.settings.print_by_long_edge {
+        return;
+    }
+    let unit = app.session.print.guides.units;
+    let current = app.ui.settings.print_long_edge_in;
+    row(ui, t, "Long edge", |ui| {
+        if let Some(v) = length(ui, "printLongEdge", current, unit, MIN_LONG_EDGE_IN, MAX_LONG_EDGE_IN) {
+            app.ui.settings.print_long_edge_in = v;
+        }
+    });
+    ui.horizontal_wrapped(|ui| {
+        ui.spacing_mut().item_spacing = egui::vec2(3.0, 3.0);
+        for inches in QUICK_SIZES {
+            let on = (current - inches).abs() < 1e-6;
+            if text_button(ui, &format!("printLongEdge-{inches}"), &format!("{inches} in"), on).clicked() {
+                app.ui.settings.print_long_edge_in = inches;
+            }
+        }
+    });
+    let area = app.session.print.layout.printable().ok();
+    if let (Some(first), Some(area)) = (app.ui.modules.long_edge_ids.first(), area)
+        && let Some((pw, ph)) = photo_size(app, *first)
+        && let Some((w, h, _)) = cell_size(pw, ph, app.ui.settings.print_long_edge_in, area.w, area.h)
+    {
+        row(ui, t, "Print size", |ui| {
+            let r = ui.label(RichText::new(format!("{} × {}", fmt_len(w, unit), fmt_len(h, unit))).color(t.text));
+            register(ui, "label:printSize", r.rect);
+        });
+    }
+    if app.ui.modules.long_edge_scaled {
+        ui.label(RichText::new(ptr("Shrunk to fit the printable area of the paper")).color(t.caution));
+    }
+    let skipped = app.ui.modules.long_edge_skipped;
+    if skipped > 0 {
+        let r = ui.label(
+            RichText::new(crate::i18n::tr_format!(
+                "{n} selected photos are not printed: at most {max} photos (one page each), and none too small for this long edge",
+                n = skipped,
+                max = layout::MAX_PAGES
+            ))
+            .color(t.caution),
+        );
+        register(ui, "label:printSkipped", r.rect);
+    }
+    if let Some(e) = app.ui.modules.long_edge_error.clone() {
+        ui.label(RichText::new(e).color(t.caution));
+    }
+    ui.label(
+        RichText::new(ptr("Each photo prints centred on its own page at its own aspect ratio. The photo itself is not changed.")).color(t.text_dim),
+    );
+    ui.label(RichText::new(ptr("More layouts: turn off Size by long edge")).color(t.text_dim));
+}
+
+/// Print to PDF the photos on the pages shown, and what it makes.
+fn print_button(app: &mut LightcraftApp, ui: &mut Ui, t: &Tokens, ids: &[PhotoId]) {
+    let enabled = !ids.is_empty() && app.export.is_none();
+    ui.add_enabled_ui(enabled, |ui| {
+        if text_button(ui, "printModulePdf", "Print to PDF…", false).clicked() {
+            // the photos laid out, so the PDF and its summary hold exactly the pages shown
+            let params = if app.ui.settings.print_by_long_edge { json!({"ids": ids.iter().map(|id| id.0).collect::<Vec<_>>()}) } else { json!({}) };
+            if let Err(e) = app.run("app.print", params) {
+                app.toast_error(ui.ctx(), e);
+            }
+        }
+    });
+    ui.label(RichText::new(ptr("LightCraft prints to a PDF file: open it in a PDF viewer or PhotoCraft to send it to the printer.")).color(t.text_dim));
+}
+
+/// The module: the settings column on the right, the page preview filling the rest.
+pub fn show(app: &mut LightcraftApp, ui: &mut Ui) {
+    let t = Tokens::get(ui.ctx());
+    // File ▸ Print… draws the same preview and settings (and their ids) in its window
+    if matches!(app.ui.dialog, Some(crate::state::Dialog::Print)) {
+        ui.painter().rect_filled(ui.max_rect(), 0.0, t.chrome);
+        return;
+    }
+    sync_long_edge(app);
+    let ids = print_photos(app);
+    let mut pu = std::mem::take(&mut app.ui.print);
+    let st = app.session.print.clone();
+    let pages = st.layout.page_count(ids.len());
+    pu.page = pu.page.min(pages.saturating_sub(1));
+    if pu.selected.is_some_and(|c| st.layout.cell(c).is_none_or(|c| c.page as usize != pu.page)) {
+        pu.selected = pu.selected.filter(|c| st.layout.cell(*c).is_some());
+    }
+    egui::Panel::right("print_module_settings")
+        .exact_size(SETTINGS_W)
+        .resizable(false)
+        .frame(egui::Frame::NONE.fill(t.chrome).inner_margin(egui::Margin { left: 12, right: 8, top: 8, bottom: 8 }))
+        .show(ui, |ui| {
+            register(ui, "panel:printModule", ui.max_rect());
+            egui::ScrollArea::vertical().id_salt("print-module-settings").auto_shrink([false, false]).show(ui, |ui| {
+                ui.set_width(SETTINGS_W - 34.0);
+                ui.spacing_mut().item_spacing.y = 5.0;
+                size_section(app, ui, &t);
+                if app.ui.settings.print_by_long_edge {
+                    print_view::page_setup_section(app, ui, &t, &st);
+                    print_view::print_job_section(app, ui, &t, &st);
+                } else {
+                    print_view::settings(app, ui, &t, &mut pu, &st, ids.len());
+                }
+                ui.add_space(14.0);
+                print_button(app, ui, &t, &ids);
+                ui.add_space(8.0);
+            });
+        });
+    egui::CentralPanel::default().frame(egui::Frame::NONE.fill(t.chrome).inner_margin(12)).show(ui, |ui| {
+        // Lights Out and toasts follow the page preview, not the dock's last canvas
+        app.canvas_rect = Some(ui.max_rect());
+        app.image_rect = None;
+        if ids.is_empty() {
+            ui.centered_and_justified(|ui| {
+                ui.label(RichText::new(ptr("Select the photos to print in Library first.")).color(t.text_dim));
+            });
+        } else {
+            print_view::preview(app, ui, &t, &mut pu, &st, &ids, pages);
+        }
+    });
+    app.ui.print = pu;
+}
