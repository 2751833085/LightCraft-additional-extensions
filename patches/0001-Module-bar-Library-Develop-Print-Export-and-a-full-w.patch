@@ -0,0 +1,186 @@
+//! The module bar (Library | Develop | Print | Export) and the Print module's Size by long edge,
+//! driven through the control channel as a person clicks them.
+
+use std::time::Duration;
+
+use serde_json::{Value, json};
+
+use crate::headless::Headless;
+use crate::panels::modules::{self, Module};
+use crate::panels::print_module::cell_size;
+use crate::state::{Dialog, RightPanel, ViewMode};
+use crate::{LightcraftApp, Services};
+use lightcraft_engine::print::layout::{Orientation, Style};
+
+const T: Duration = Duration::from_secs(30);
+
+fn demo() -> Headless {
+    let app = LightcraftApp::new(lightcraft_engine::Session::with_demo(), Services::default());
+    let mut h = Headless::new(app, [1400.0, 900.0], 1.0);
+    h.settle(T);
+    h
+}
+
+fn has(h: &Headless, id: &str) -> bool {
+    h.app.widgets.iter().any(|(w, _)| w == id)
+}
+
+fn click(h: &mut Headless, id: &str) {
+    let r = h.request("ui.clickWidget", json!({"id": id}), T);
+    assert_eq!(r["ok"], true, "{id}: {r}");
+    h.settle(T);
+}
+
+fn cmd(h: &mut Headless, id: &str, params: Value) -> Value {
+    let r = h.request("engine.execute", json!({"command": id, "params": params}), T);
+    assert_eq!(r["ok"], true, "{id}: {r}");
+    h.settle(T);
+    r["result"].clone()
+}
+
+/// Select the first `n` visible photos.
+fn select(h: &mut Headless, n: usize) -> Vec<u64> {
+    let ids: Vec<u64> = h.app.session.visible_cloned().into_iter().take(n).map(|id| id.0).collect();
+    assert_eq!(ids.len(), n, "the demo library has {n} photos");
+    cmd(h, "library.select", json!({"ids": ids}));
+    ids
+}
+
+#[test]
+fn the_bar_is_in_the_top_bar_and_switches_the_four_modules() {
+    let mut h = demo();
+    for m in Module::ALL {
+        assert!(has(&h, &format!("button:module-{}", m.id())), "{m:?} is on the bar");
+    }
+    assert!(!has(&h, "icon:share"), "the bar's Export replaces the Export icon");
+
+    click(&mut h, "button:module-library");
+    assert_eq!(modules::current(&h.app), Module::Library);
+    assert_eq!(h.app.ui.view, ViewMode::PhotoGrid);
+    assert!(h.app.ui.left_panel, "Library shows the left panel");
+
+    click(&mut h, "button:module-develop");
+    assert_eq!(modules::current(&h.app), Module::Develop);
+    assert_eq!(h.app.ui.view, ViewMode::Detail);
+    assert_eq!(h.app.ui.right, RightPanel::Edit, "Develop opens the Edit panel");
+    // clicking it again keeps Edit open (the panel command would toggle it off)
+    click(&mut h, "button:module-develop");
+    assert_eq!(h.app.ui.right, RightPanel::Edit);
+
+    click(&mut h, "button:module-print");
+    assert_eq!(modules::current(&h.app), Module::Print);
+    assert!(has(&h, "panel:printModule") && has(&h, "print:page"), "the Print module fills the window");
+    assert!(!has(&h, "panel:right_panel"), "no dock while printing");
+
+    click(&mut h, "button:module-export");
+    assert!(matches!(h.app.ui.dialog, Some(Dialog::Export { .. })), "Export opens the Export dialog");
+    assert_eq!(modules::current(&h.app), Module::Export);
+}
+
+#[test]
+fn the_module_commands_have_lightroom_classic_keys_and_menu_items() {
+    for (id, key) in [("module.library", Some("Cmd+Alt+1")), ("module.develop", Some("Cmd+Alt+2")), ("module.print", Some("Cmd+Alt+6")), ("module.export", None)]
+    {
+        let c = crate::menus::ui_commands().find(|c| c.0 == id).unwrap_or_else(|| panic!("{id} is a UI command"));
+        assert_eq!(c.2, key, "{id}");
+        assert_eq!(c.3, "Window", "{id}");
+    }
+    let mut h = demo();
+    cmd(&mut h, "module.print", json!({}));
+    assert_eq!(crate::menubar::checked(&h.app, "module.print"), Some(true));
+    assert_eq!(crate::menubar::checked(&h.app, "module.library"), Some(false));
+}
+
+#[test]
+fn a_view_command_leaves_the_print_module() {
+    let mut h = demo();
+    select(&mut h, 1);
+    cmd(&mut h, "module.print", json!({}));
+    assert!(modules::print_active(&h.app));
+    // G in Lightroom: the grid
+    cmd(&mut h, "view.photoGrid", json!({}));
+    assert!(!modules::print_active(&h.app), "a view change leaves Print");
+    assert_eq!(modules::current(&h.app), Module::Library);
+    assert!(!has(&h, "panel:printModule"), "the Print module is gone");
+}
+
+#[test]
+fn a_long_edge_cell_keeps_the_aspect_ratio_and_shrinks_only_to_fit() {
+    // 3:2 landscape at 10 in in a landscape Letter's printable area (10.5 × 8)
+    let (w, h, shrunk) = cell_size(6000.0, 4000.0, 10.0, 10.5, 8.0).unwrap();
+    assert!((w - 10.0).abs() < 1e-9 && (h - 20.0 / 3.0).abs() < 1e-9 && !shrunk, "{w} × {h}");
+    // portrait photo: the height is the long edge
+    let (w, h, _) = cell_size(4000.0, 6000.0, 10.0, 8.0, 10.5).unwrap();
+    assert!((h - 10.0).abs() < 1e-9 && (w - 20.0 / 3.0).abs() < 1e-9, "{w} × {h}");
+    // the same landscape photo on a portrait Letter (8 × 10.5): shrunk to the width, ratio kept
+    let (w, h, shrunk) = cell_size(6000.0, 4000.0, 10.0, 8.0, 10.5).unwrap();
+    assert!((w - 8.0).abs() < 1e-9 && (h - 16.0 / 3.0).abs() < 1e-9 && shrunk, "{w} × {h}");
+    assert!(cell_size(0.0, 4000.0, 10.0, 8.0, 10.5).is_none());
+    assert!(cell_size(6000.0, 4000.0, f64::NAN, 8.0, 10.5).is_none());
+}
+
+#[test]
+fn size_by_long_edge_centres_each_photo_on_its_own_page_without_changing_it() {
+    let mut h = demo();
+    let ids = select(&mut h, 2);
+    let develop_before: Vec<_> =
+        ids.iter().map(|id| h.app.session.catalog.photo(lightcraft_catalog::PhotoId(*id)).unwrap().develop.clone()).collect();
+    assert!(h.app.ui.settings.print_by_long_edge, "on by default");
+    assert_eq!(h.app.ui.settings.print_long_edge_in, 10.0, "10 in by default");
+    cmd(&mut h, "print.set", json!({"layout": {"page": {"orientation": "landscape"}}}));
+    click(&mut h, "button:module-print");
+    let layout = h.app.session.print.layout.clone();
+    assert_eq!(layout.page.orientation, Orientation::Landscape);
+    assert_eq!(layout.style, Style::CustomPackage);
+    assert_eq!(layout.cells.len(), 2, "one cell per photo");
+    assert_eq!(layout.pages, 2, "each on its own page");
+    let area = layout.printable().unwrap();
+    for (cell, id) in layout.cells.iter().zip(&ids) {
+        assert_eq!(cell.photo, Some(*id));
+        let r = cell.rect;
+        let p = h.app.session.catalog.photo(lightcraft_catalog::PhotoId(*id)).unwrap();
+        let (pw, ph) = lightcraft_pipeline::native_output_size(p.width as usize, p.height as usize, &p.develop);
+        let (ew, eh, _) = cell_size(pw, ph, 10.0, area.w, area.h).unwrap();
+        assert!((r.w - ew).abs() < 1e-6 && (r.h - eh).abs() < 1e-6, "cell {r:?} for {pw} × {ph}");
+        assert!((r.w.max(r.h) - 10.0).abs() < 1e-6 || h.app.ui.modules.long_edge_scaled, "10 in long edge unless shrunk: {r:?}");
+        assert!((r.x + r.w / 2.0 - (area.x + area.w / 2.0)).abs() < 1e-6, "centred across: {r:?}");
+        assert!((r.y + r.h / 2.0 - (area.y + area.h / 2.0)).abs() < 1e-6, "centred down: {r:?}");
+    }
+    // a new long edge lays the pages out again
+    h.app.ui.settings.print_long_edge_in = 6.0;
+    h.settle(T);
+    let r = h.app.session.print.layout.cells[0].rect;
+    assert!((r.w.max(r.h) - 6.0).abs() < 1e-6, "{r:?}");
+    let develop_after: Vec<_> =
+        ids.iter().map(|id| h.app.session.catalog.photo(lightcraft_catalog::PhotoId(*id)).unwrap().develop.clone()).collect();
+    assert_eq!(develop_before, develop_after, "printing never edits the photo");
+}
+
+#[test]
+fn turning_size_by_long_edge_off_shows_every_print_layout_style() {
+    let mut h = demo();
+    select(&mut h, 1);
+    click(&mut h, "button:module-print");
+    assert!(has(&h, "drag:printLongEdge") && !has(&h, "button:printStyle-0"));
+    click(&mut h, "check:printByLongEdge");
+    assert!(!h.app.ui.settings.print_by_long_edge);
+    assert!(has(&h, "button:printStyle-0"), "the layout styles are back");
+    assert!(has(&h, "button:printModulePdf"), "Print to PDF stays");
+}
+
+#[test]
+fn chinese_names_follow_lightroom_classic() {
+    use crate::i18n::{Locale, set_language};
+    set_language(Locale::ZhHans);
+    assert_eq!(Module::Library.name(), "图库");
+    assert_eq!(Module::Develop.name(), "修改照片");
+    assert_eq!(Module::Print.name(), "打印");
+    assert_eq!(Module::Export.name(), "导出");
+    assert_eq!(crate::print_view::ptr("Portrait"), "纵向", "a page orientation, not a portrait profile");
+    assert_eq!(crate::print_view::ptr("Paper"), "纸张");
+    assert_eq!(crate::i18n::tr("Portrait"), "人像", "elsewhere the plain translation stays");
+    set_language(Locale::ZhHant);
+    assert_eq!(Module::Develop.name(), "修改相片");
+    set_language(Locale::En);
+    assert_eq!(Module::Develop.name(), "Develop");
+}
