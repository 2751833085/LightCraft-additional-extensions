+        return Some(crate::i18n::tr_format!("{what} failed: {e}", what = what, e = e));
+    }
+    let why = outcome.get("skipped").and_then(Value::as_str)?;
+    (why == "not available here").then(|| crate::i18n::tr_format!("{what}: not available here", what = what))
