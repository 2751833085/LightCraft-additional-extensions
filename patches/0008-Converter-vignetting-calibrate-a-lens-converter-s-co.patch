diff --git a/crates/ui-egui/src/dialogs/converter.rs b/crates/ui-egui/src/dialogs/converter.rs
new file mode 100644
index 000000000..65cbaa3bd
--- /dev/null
+++ b/crates/ui-egui/src/dialogs/converter.rs
@@ -0,0 +1,417 @@
+//! Converter vignetting in the Edit panel's Optics section: a lens converter (a tele or wide adapter on a
+//! fixed-lens camera) darkens the corners more than the bare lens's profile knows. The photo's correction is a
+//! develop setting (`optics.converter_k`, strength `optics.converterAmount`); the corrections are measured from
+//! flat-field photos (`optics.fitConverterVignette`, `lightcraft_engine::flat_field`) and kept as named
+//! profiles in the app's settings ([`ConverterProfile`], `ui.json`).
+//!
+//! The row is a dropdown (`combo:converterProfile`): None (`item:converterProfile-none`), each saved profile
+//! (`item:converterProfile-<index>`), Create from Selected Flat-Field Photo… (`item:converterProfile-create`)
+//! and Manage Profiles… (`item:converterProfile-manage`). Choosing a profile sets the active photo's
+//! coefficients in one undo step (Auto Sync, Sync and Copy Settings carry it to other photos, as every Optics
+//! edit). Create measures the active photo in the background and opens the dialog that names the new profile
+//! (`field:converterName`, Save = `button:dialogOk`) and lists the saved ones (`button:converterRename-<i>`,
+//! `field:converterRename`, `button:converterDelete-<i>`). `app.converterProfiles` does the same for scripts.
+
+use lightcraft_catalog::PhotoId;
+use lightcraft_develop::DevelopSettings;
+use lightcraft_engine::media::SourceLevel;
+use serde_json::{Value, json};
+
+use crate::LightcraftApp;
+use crate::state::{ConverterProfile, Dialog};
+use crate::theme::Tokens;
+use crate::widgets::register;
+
+/// The background measurement's row in the activity stack.
+const LABEL: &str = "Measuring converter vignetting";
+
+/// Whether two coefficient sets are the same correction (a profile's and a photo's).
+fn same_k(a: &[f64; 5], b: &[f64; 5]) -> bool {
+    a.iter().zip(b).all(|(x, y)| (x - y).abs() <= 1e-12 * x.abs().max(1.0))
+}
+
+/// What the dropdown shows for coefficients `k`: None, the saved profile with them, or Custom.
+pub(crate) fn current_label(profiles: &[ConverterProfile], k: &[f64; 5]) -> String {
+    if k.iter().all(|v| *v == 0.0) {
+        return crate::i18n::tr("None").to_string();
+    }
+    profiles.iter().find(|p| same_k(&p.k, k)).map_or_else(|| crate::i18n::tr("Custom").to_string(), |p| p.name.clone())
+}
+
+/// An f-number as cameras show it: 2.8, 4, 5.6.
+fn f_number(a: f32) -> String {
+    let s = format!("{a:.1}");
+    s.strip_suffix(".0").map(str::to_string).unwrap_or(s)
+}
+
+/// The name a new profile starts with: the camera model, the converter (named for the cameras whose one is
+/// known), the aperture: "GR IIIx + GT-2 · f/2.8".
+pub(crate) fn default_name(make: &str, camera: &str, aperture: Option<f32>) -> String {
+    let mut model = camera.trim();
+    if !make.trim().is_empty()
+        && let Some(rest) = model.strip_prefix(make.trim())
+    {
+        model = rest.trim();
+    }
+    // "RICOH GR IIIx" from a make of "RICOH IMAGING COMPANY, LTD.": the maker's first word goes too
+    if let Some(word) = make.split_whitespace().next().filter(|w| w.len() > 1)
+        && let Some(head) = model.get(..word.len())
+        && head.eq_ignore_ascii_case(word)
+        && model[word.len()..].starts_with(' ')
+    {
+        model = model[word.len()..].trim();
+    }
+    let converter = if model.contains("GR IIIx") {
+        "GT-2"
+    } else if model.contains("GR III") {
+        "GW-4"
+    } else {
+        crate::i18n::tr("Converter")
+    };
+    let mut name = if model.is_empty() { converter.to_string() } else { format!("{model} + {converter}") };
+    if let Some(a) = aperture.filter(|a| a.is_finite() && *a > 0.0) {
+        name.push_str(&format!(" · f/{}", f_number(a)));
+    }
+    name
+}
+
+/// Set the active photo's converter correction to `k` (zeros: none), as one undo step. A correction chosen
+/// while the amount is 0 comes back at 100.
+pub(crate) fn apply(app: &mut LightcraftApp, k: [f64; 5], label: &str) -> Result<Value, String> {
+    let id = app.session.active().ok_or("no active photo")?;
+    let d = app.session.develop_of(id).unwrap_or_default();
+    let mut optics = json!({"converter_k": k});
+    if k.iter().any(|v| *v != 0.0) && d.optics.converter_amount == 0.0 {
+        optics["converter_amount"] = json!(100.0);
+    }
+    app.run("develop.merge", json!({"settings": {"optics": optics}, "label": label}))
+}
+
+/// The Optics section's Converter Vignetting row (and its Amount slider when a correction is set).
+pub(crate) fn optics_row(app: &mut LightcraftApp, ui: &mut egui::Ui, d: &DevelopSettings) {
+    let t = Tokens::get(ui.ctx());
+    let k = d.optics.converter_k;
+    let shown = current_label(&app.ui.settings.converter_profiles, &k);
+    let mut picked: Option<(String, [f64; 5])> = None;
+    let (mut create, mut manage) = (false, false);
+    egui::Frame::NONE.inner_margin(egui::Margin { left: 24, right: 22, top: 6, bottom: 2 }).show(ui, |ui| {
+        ui.label(egui::RichText::new(crate::i18n::tr("Converter Vignetting")).size(12.0).color(t.text_label));
+        // (the dropdown under its label, the panel's width: a profile's name is often long)
+        let combo = crate::widgets::combo_box("converterProfile").width(ui.available_width()).selected_text(shown).show_ui(ui, |ui| {
+            let none = k.iter().all(|v| *v == 0.0);
+            let r = ui.selectable_label(none, crate::i18n::tr("None"));
+            register(ui, "item:converterProfile-none", r.rect);
+            if r.clicked() && !none {
+                picked = Some(("None".into(), [0.0; 5]));
+            }
+            for (i, p) in app.ui.settings.converter_profiles.iter().enumerate() {
+                let on = same_k(&p.k, &k);
+                let r = ui.selectable_label(on, &p.name);
+                register(ui, format!("item:converterProfile-{i}"), r.rect);
+                if r.clicked() && !on {
+                    picked = Some((p.name.clone(), p.k));
+                }
+            }
+            ui.separator();
+            let r = ui.selectable_label(false, crate::i18n::tr("Create from Selected Flat-Field Photo…"));
+            register(ui, "item:converterProfile-create", r.rect);
+            create |= r.clicked();
+            if !app.ui.settings.converter_profiles.is_empty() {
+                let r = ui.selectable_label(false, crate::i18n::tr("Manage Profiles…"));
+                register(ui, "item:converterProfile-manage", r.rect);
+                manage |= r.clicked();
+            }
+        });
+        crate::widgets::name_combo(&combo.response, crate::i18n::tr("Converter Vignetting"));
+        register(ui, "combo:converterProfile", combo.response.rect);
+    });
+    if let Some((name, k)) = picked
+        && let Err(e) = apply(app, k, &format!("{}: {}", crate::i18n::tr("Converter Vignetting"), crate::i18n::tr(&name)))
+    {
+        app.toast(ui.ctx(), e);
+    }
+    if create && let Err(e) = start_measure(app) {
+        app.toast(ui.ctx(), e);
+    }
+    if manage {
+        app.ui.dialog = Some(Dialog::ConverterProfile { photo: None, fit: None, name: String::new(), error: None, rename: None });
+    }
+    if d.optics.has_converter() {
+        crate::panels::edit::control(app, ui, d, "optics.converterAmount", true);
+    }
+}
+
+/// Create from Selected Flat-Field Photo…: open the dialog for the active photo and measure it in the
+/// background (a raw's decode takes a moment); the dialog shows the result, or why there is none, when it is in.
+pub(crate) fn start_measure(app: &mut LightcraftApp) -> Result<Value, String> {
+    if app.tasks.is_running(LABEL) {
+        return Err(crate::i18n::tr("A flat-field photo is already being measured.").to_string());
+    }
+    let id = app.session.active().ok_or_else(|| crate::i18n::tr("Select the flat-field photo first.").to_string())?;
+    let photo = app.session.catalog.photo(id).ok_or("no such photo")?.clone();
+    let settings = app.session.develop_of(id).unwrap_or_default();
+    let info = app.session.source_info(id);
+    let source = app.session.media.source_ref(&photo, SourceLevel::Preview);
+    let meta = &photo.meta;
+    let base = ConverterProfile {
+        camera: meta.camera.clone(),
+        lens: meta.lens.clone(),
+        aperture: meta.aperture,
+        focal_length: meta.focal_mm,
+        ..Default::default()
+    };
+    let name = default_name(&meta.make, &meta.camera, meta.aperture);
+    app.ui.dialog = Some(Dialog::ConverterProfile { photo: Some(id.0), fit: None, name, error: None, rename: None });
+    crate::tasks::spawn(
+        app,
+        LABEL,
+        Some("converter"),
+        move || {
+            let src = source.load_source()?;
+            let info = src.info_or(info);
+            lightcraft_engine::flat_field::fit_photo(&src.image, &info, &settings)
+        },
+        move |app, _ctx, result| finish(app, id, base, result),
+    )?;
+    Ok(json!({"pending": true, "photo": id.0}))
+}
+
+/// The measurement of `id` is in: the dialog opened for it shows it (a dialog closed meanwhile drops it).
+fn finish(app: &mut LightcraftApp, id: PhotoId, base: ConverterProfile, result: Result<lightcraft_engine::flat_field::ConverterFit, String>) {
+    let Some(Dialog::ConverterProfile { photo: Some(p), fit, error, .. }) = &mut app.ui.dialog else { return };
+    if *p != id.0 || fit.is_some() || error.is_some() {
+        return;
+    }
+    match result {
+        Ok(f) => {
+            *fit = Some(ConverterProfile { k: f.k, max_gain_stops: f.max_gain_stops, valid_radius: f.valid_radius, ..base });
+        }
+        Err(e) => *error = Some(e),
+    }
+}
+
+/// Save a profile: refused without a name, with a name another profile has, or with coefficients that
+/// aren't numbers.
+pub(crate) fn add(app: &mut LightcraftApp, mut profile: ConverterProfile) -> Result<Value, String> {
+    profile.name = profile.name.trim().to_string();
+    if profile.name.is_empty() {
+        return Err(crate::i18n::tr("Name the profile.").to_string());
+    }
+    if !profile.k.iter().all(|k| k.is_finite() && k.abs() <= lightcraft_develop::CONVERTER_K_MAX) {
+        return Err(crate::i18n::tr("The profile's coefficients aren't usable.").to_string());
+    }
+    if app.ui.settings.converter_profiles.iter().any(|p| p.name == profile.name) {
+        return Err(crate::i18n::tr("A converter profile with this name already exists.").to_string());
+    }
+    let index = app.ui.settings.converter_profiles.len();
+    app.ui.settings.converter_profiles.push(profile);
+    Ok(json!({"index": index}))
+}
+
+/// The dialog's Save.
+pub(crate) fn save(app: &mut LightcraftApp, dlg: &Dialog) -> Result<Value, String> {
+    let Dialog::ConverterProfile { fit: Some(fit), name, .. } = dlg else { return Ok(Value::Null) };
+    add(app, ConverterProfile { name: name.clone(), ..fit.clone() })
+}
+
+/// One line about a profile: the correction (with `stops`), the aperture, focal length and lens it was measured at.
+fn summary(p: &ConverterProfile, stops: bool) -> String {
+    let mut parts = Vec::new();
+    if stops {
+        parts.push(crate::i18n::tr_format!("up to {stops} stops", stops = format!("{:.1}", p.max_gain_stops)));
+    }
+    if let Some(a) = p.aperture.filter(|a| a.is_finite() && *a > 0.0) {
+        parts.push(format!("f/{}", f_number(a)));
+    }
+    if let Some(f) = p.focal_length.filter(|f| f.is_finite() && *f > 0.0) {
+        parts.push(format!("{f:.0} mm"));
+    }
+    // (the camera is in the name it starts with; the lens names a body with interchangeable lenses)
+    if !p.lens.is_empty() {
+        parts.push(p.lens.clone());
+    }
+    parts.join(" · ")
+}
+
+/// The dialog's body. True when Return in the name field saves.
+pub(crate) fn body(app: &mut LightcraftApp, ui: &mut egui::Ui, dlg: &mut Dialog) -> bool {
+    let Dialog::ConverterProfile { photo, fit, name, error, rename } = dlg else { return false };
+    let t = Tokens::get(ui.ctx());
+    let mut confirm = false;
+    if let Some(f) = fit {
+        ui.label(egui::RichText::new(crate::i18n::tr("Profile name")).color(t.text_dim));
+        confirm = super::frame::dialog_field(ui, "field:converterName", name, "Profile name");
+        let stops = format!("{:.1}", f.max_gain_stops);
+        ui.label(crate::i18n::tr_format!("The corners are brightened by up to {stops} stops.", stops = stops));
+        if f.valid_radius < 0.999 {
+            let pct = format!("{:.0}", f.valid_radius * 100.0);
+            ui.label(
+                egui::RichText::new(crate::i18n::tr_format!(
+                    "The converter cuts the corners off beyond {pct} % of the half diagonal: crop them.",
+                    pct = pct
+                ))
+                .color(t.caution),
+            );
+        }
+        let measured = summary(f, false);
+        ui.label(egui::RichText::new(measured).size(11.0).color(t.text_dim));
+    } else if let Some(e) = error {
+        let r = ui.label(egui::RichText::new(crate::i18n::tr(e)).color(t.caution));
+        register(ui, "label:converterError", r.rect);
+    } else if photo.is_some() {
+        ui.horizontal(|ui| {
+            crate::progress::spinner(ui, 14.0);
+            ui.label(crate::i18n::tr("Measuring the flat-field photo…"));
+        });
+        ui.ctx().request_repaint_after(std::time::Duration::from_millis(100));
+    }
+    profiles_list(app, ui, &t, rename, photo.is_some());
+    confirm
+}
+
+/// The saved profiles, each with Rename and Delete.
+fn profiles_list(app: &mut LightcraftApp, ui: &mut egui::Ui, t: &Tokens, rename: &mut Option<(usize, String)>, measuring: bool) {
+    let profiles = app.ui.settings.converter_profiles.clone();
+    if profiles.is_empty() {
+        if !measuring {
+            ui.label(egui::RichText::new(crate::i18n::tr("No converter profiles yet.")).color(t.text_dim));
+        }
+        return;
+    }
+    if measuring {
+        ui.add_space(6.0);
+        ui.separator();
+    }
+    ui.label(egui::RichText::new(crate::i18n::tr("Saved Profiles")).color(t.text_dim));
+    let mut delete = None;
+    let mut renamed: Option<(usize, String)> = None;
+    for (i, p) in profiles.iter().enumerate() {
+        match rename {
+            Some((j, text)) if *j == i => {
+                let r = crate::text_field::TextField::singleline("field:converterRename", text).width(f32::INFINITY).select_on_focus(true).show(ui);
+                if !r.editing && r.ending.is_none() && ui.memory(|m| m.focused().is_none()) {
+                    r.response.request_focus();
+                }
+                match r.ending {
+                    Some(crate::text_field::Ending::Return) => renamed = Some((i, text.clone())),
+                    Some(_) => *rename = None,
+                    None => {}
+                }
+            }
+            _ => {
+                ui.horizontal(|ui| {
+                    ui.label(&p.name);
+                    ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                        if crate::widgets::text_button(ui, &format!("converterDelete-{i}"), "Delete", false).clicked() {
+                            delete = Some(i);
+                        }
+                        if crate::widgets::text_button(ui, &format!("converterRename-{i}"), "Rename", false).clicked() {
+                            *rename = Some((i, p.name.clone()));
+                        }
+                    });
+                });
+                ui.label(egui::RichText::new(summary(p, true)).size(11.0).color(t.text_dim));
+            }
+        }
+    }
+    if let Some((i, text)) = renamed {
+        match rename_profile(app, i, &text) {
+            Ok(_) => *rename = None,
+            Err(e) => app.toast(ui.ctx(), e),
+        }
+    }
+    if let Some(i) = delete
+        && i < app.ui.settings.converter_profiles.len()
+    {
+        app.ui.settings.converter_profiles.remove(i);
+        *rename = None;
+    }
+}
+
+/// Rename saved profile `i` to `to` (not empty, not another profile's name).
+fn rename_profile(app: &mut LightcraftApp, i: usize, to: &str) -> Result<Value, String> {
+    let to = to.trim();
+    if to.is_empty() {
+        return Err(crate::i18n::tr("Name the profile.").to_string());
+    }
+    let profiles = &mut app.ui.settings.converter_profiles;
+    if profiles.iter().enumerate().any(|(j, p)| j != i && p.name == to) {
+        return Err(crate::i18n::tr("A converter profile with this name already exists.").to_string());
+    }
+    let p = profiles.get_mut(i).ok_or("no such converter profile")?;
+    p.name = to.to_string();
+    Ok(json!({"index": i}))
+}
+
+/// The index of the saved profile `p` names (`name`, or `index`).
+fn find(app: &LightcraftApp, p: &Value) -> Result<usize, String> {
+    let profiles = &app.ui.settings.converter_profiles;
+    if let Some(i) = p.get("index").and_then(Value::as_u64) {
+        return usize::try_from(i).ok().filter(|i| *i < profiles.len()).ok_or_else(|| "no such converter profile".to_string());
+    }
+    let name = p.get("name").and_then(Value::as_str).ok_or("name the profile (`name` or `index`)")?;
+    profiles.iter().position(|q| q.name == name).ok_or_else(|| format!("no converter profile named {name:?}"))
+}
+
+/// `app.converterProfiles {action: list|add|delete|rename|apply|measure, …}`: the saved converter vignetting
+/// profiles. `add {profile: {name, k, camera?, lens?, aperture?, focalLength?, maxGainStops?, validRadius?}}`,
+/// `delete {name | index}`, `rename {name | index, to}`, `apply {name | index}` (no name and no index: none)
+/// sets the active photo's correction, `measure` is Create from Selected Flat-Field Photo….
+pub(crate) fn command(app: &mut LightcraftApp, p: &Value) -> Result<Value, String> {
+    let list = |app: &LightcraftApp| json!({"profiles": app.ui.settings.converter_profiles});
+    match p.get("action").and_then(Value::as_str).unwrap_or("list") {
+        "list" => Ok(list(app)),
+        "add" => {
+            let profile: ConverterProfile =
+                serde_json::from_value(p.get("profile").cloned().unwrap_or(Value::Null)).map_err(|e| format!("invalid `profile`: {e}"))?;
+            add(app, profile)?;
+            Ok(list(app))
+        }
+        "delete" => {
+            let i = find(app, p)?;
+            app.ui.settings.converter_profiles.remove(i);
+            Ok(list(app))
+        }
+        "rename" => {
+            let i = find(app, p)?;
+            let to = p.get("to").and_then(Value::as_str).ok_or("missing `to`")?.to_string();
+            rename_profile(app, i, &to)?;
+            Ok(list(app))
+        }
+        "apply" => {
+            let (name, k) = if p.get("name").is_none() && p.get("index").is_none() {
+                ("None".to_string(), [0.0; 5])
+            } else {
+                let i = find(app, p)?;
+                let q = &app.ui.settings.converter_profiles[i];
+                (q.name.clone(), q.k)
+            };
+            apply(app, k, &format!("{}: {}", crate::i18n::tr("Converter Vignetting"), crate::i18n::tr(&name)))?;
+            Ok(json!({"applied": name, "k": k}))
+        }
+        "measure" => start_measure(app),
+        other => Err(format!("unknown action {other:?} (list, add, delete, rename, apply, measure)")),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn default_names_say_camera_converter_and_aperture() {
+        assert_eq!(default_name("RICOH IMAGING COMPANY, LTD.", "RICOH IMAGING COMPANY, LTD. RICOH GR IIIx", Some(2.8)), "GR IIIx + GT-2 · f/2.8");
+        assert_eq!(default_name("RICOH IMAGING COMPANY, LTD.", "RICOH IMAGING COMPANY, LTD. RICOH GR III", Some(4.0)), "GR III + GW-4 · f/4");
+        assert_eq!(default_name("FUJIFILM", "FUJIFILM X100V", Some(5.6)), "X100V + Converter · f/5.6");
+        assert_eq!(default_name("", "", None), "Converter");
+        assert_eq!(default_name("", "Cam", Some(f32::NAN)), "Cam + Converter");
+    }
+
+    #[test]
+    fn the_dropdown_names_the_matching_profile() {
+        let profiles = vec![ConverterProfile { name: "A".into(), k: [0.5, 0.1, 0.0, 0.0, 0.0], ..Default::default() }];
+        assert_eq!(current_label(&profiles, &[0.0; 5]), "None");
+        assert_eq!(current_label(&profiles, &[0.5, 0.1, 0.0, 0.0, 0.0]), "A");
+        assert_eq!(current_label(&profiles, &[0.5, 0.2, 0.0, 0.0, 0.0]), "Custom");
+    }
+}
