+//! `optics.fitConverterVignette`: a flat-field photo measured through the library, its falloff recovered,
+//! the photo left as it was; and the correction it gives flattens the photo when applied.
+
+use lightcraft_catalog::PhotoId;
+use serde_json::json;
+
+use crate::Session;
+
+/// The converter's falloff the synthetic flat field carries (about 2.3 stops at the corners).
+pub(crate) fn falloff(r: f64) -> f64 {
+    let r2 = r * r;
+    1.0 + 0.5 * r2 + 1.0 * r2 * r2 + 3.4 * r2 * r2 * r2
+}
+
+/// A 16-bit sRGB TIFF of an evenly lit surface through the converter, `level` (linear) at the centre,
+/// with the camera and aperture in its XMP.
+pub(crate) fn write_flat_field(path: &std::path::Path, w: usize, h: usize, level: f64) {
+    use lightcraft_codecs::{EncodeImage, EncodeMeta, Samples, TiffCompression, encode_tiff};
+    let hd = (w as f64).hypot(h as f64) / 2.0;
+    let px: Vec<u16> = (0..w * h)
+        .flat_map(|i| {
+            let (x, y) = ((i % w) as f64 + 0.5 - w as f64 / 2.0, (i / w) as f64 + 0.5 - h as f64 / 2.0);
+            let v = lightcraft_color::transfer::linear_to_srgb((level / falloff(x.hypot(y) / hd)) as f32);
+            let v = (v.clamp(0.0, 1.0) * 65535.0).round() as u16;
+            [v, v, v]
+        })
+        .collect();
+    let xmp = r#"<x:xmpmeta xmlns:x="adobe:ns:meta/"><rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
+<rdf:Description rdf:about="" xmlns:tiff="http://ns.adobe.com/tiff/1.0/" xmlns:exif="http://ns.adobe.com/exif/1.0/"
+ tiff:Make="RICOH IMAGING COMPANY, LTD." tiff:Model="RICOH GR IIIx" exif:FNumber="28/10" exif:FocalLength="183/10"/></rdf:RDF></x:xmpmeta>"#;
+    let meta = EncodeMeta { xmp: Some(xmp), ..EncodeMeta::default() };
+    let bytes = encode_tiff(&EncodeImage::new(w as u32, h as u32, 3, Samples::U16(&px)), TiffCompression::Deflate, &meta).unwrap();
+    std::fs::write(path, bytes).unwrap();
+}
+
+fn flat_session(tag: &str) -> (Session, PhotoId, std::path::PathBuf) {
+    let dir = std::env::temp_dir().join(format!("lc-converter-{tag}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let path = dir.join("flat.tif");
+    write_flat_field(&path, 1200, 800, 0.35);
+    let mut s = Session::new().with_fs();
+    s.execute("library.import", &json!({"paths": [path.to_string_lossy()]})).unwrap();
+    let id = s.catalog.photos().next().map(|p| p.id).unwrap();
+    s.execute("library.select", &json!({"ids": [id.0]})).unwrap();
+    (s, id, dir)
+}
+
+#[test]
+fn a_flat_field_photo_gives_its_falloff_and_is_left_unchanged() {
+    let (mut s, id, dir) = flat_session("fit");
+    let before = s.develop_of(id).unwrap();
+    let commits = s.commits();
+    let r = s.execute("optics.fitConverterVignette", &json!({})).unwrap();
+    let k: [f64; 5] = serde_json::from_value(r["k"].clone()).unwrap();
+    for i in 0..=10 {
+        let x = i as f64 / 10.0;
+        let got = lightcraft_pipeline::optics::converter_gain(&k, 1.0, x * x);
+        assert!((got / falloff(x) - 1.0).abs() < 0.015, "r {x}: {got} vs {} ({r})", falloff(x));
+    }
+    assert!((r["maxGainStops"].as_f64().unwrap() - falloff(1.0).log2()).abs() < 0.05, "{r}");
+    assert_eq!(r["validRadius"], json!(1.0));
+    assert!(r["rms"].as_f64().unwrap() < 0.01, "{r}");
+    for key in ["aperture", "focalLength", "camera", "lens"] {
+        assert!(r.get(key).is_some(), "{key}: {r}");
+    }
+    // the same by id, and the photo isn't touched
+    let by_id = s.execute("optics.fitConverterVignette", &json!({"id": id.0})).unwrap();
+    assert_eq!(by_id["k"], r["k"]);
+    assert_eq!(s.develop_of(id).unwrap(), before);
+    assert_eq!(s.commits(), commits, "a measurement is no edit");
+    // a correction already applied is not measured again (the residual stays the converter's)
+    s.execute("develop.merge", &json!({"settings": {"optics": {"converter_k": k}}})).unwrap();
+    let again = s.execute("optics.fitConverterVignette", &json!({})).unwrap();
+    assert_eq!(again["k"], r["k"]);
+    assert!(s.execute("optics.fitConverterVignette", &json!({"id": 999_999})).is_err());
+    assert!(s.execute("optics.fitConverterVignette", &json!({"id": "x"})).is_err());
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+/// The fitted correction, applied, flattens the photo: the corners come up to the centre, the centre stays.
+#[test]
+fn the_fitted_correction_flattens_the_render() {
+    let (mut s, id, dir) = flat_session("render");
+    let r = s.execute("optics.fitConverterVignette", &json!({})).unwrap();
+    let luma = |s: &mut Session| {
+        let req = lightcraft_pipeline::RenderRequest::fit(300, 300);
+        let src = s.source_now(id, crate::media::SourceLevel::Preview).unwrap();
+        let info = s.source_info(id);
+        let d = s.develop_of(id).unwrap();
+        let img = lightcraft_pipeline::render(&src, &info, &d, &req).image;
+        let at = |x: usize, y: usize| img.data[y * img.width + x][1] as f64;
+        (at(img.width / 2, img.height / 2), at(2, 2))
+    };
+    let (centre, corner) = luma(&mut s);
+    assert!(corner < centre * 0.6, "{corner} vs {centre}");
+    s.execute("develop.merge", &json!({"settings": {"optics": {"converter_k": r["k"]}}})).unwrap();
+    let (c2, k2) = luma(&mut s);
+    assert!((c2 - centre).abs() <= 2.0, "the centre stays: {c2} vs {centre}");
+    assert!((k2 - c2).abs() <= 4.0, "the corner comes up to the centre: {k2} vs {c2}");
+    let _ = std::fs::remove_dir_all(&dir);
+}
