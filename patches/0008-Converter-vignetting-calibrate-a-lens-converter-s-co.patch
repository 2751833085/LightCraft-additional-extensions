+/// Converter vignetting: the polynomial at the corners, scaled by its amount, on top of the manual
+/// vignetting, independent of the lens-profile toggle, and off with the optics section.
+#[test]
+fn converter_vignette_gain_follows_the_polynomial_and_amount() {
+    let mut s = DevelopSettings::default();
+    s.optics.converter_k = [1.0, 0.5, 0.0, 0.0, 0.25];
+    let wp = Warp::from_settings(300.0, 400.0, &s, None);
+    assert!(wp.has_gain() && !wp.moves_pixels() && !wp.is_identity());
+    assert!((wp.gain(Point::new(150.0, 200.0)) - 1.0).abs() < 1e-6, "the centre is untouched");
+    // a corner is at r = 1: 1 + 1 + 0.5 + 0.25
+    assert!((wp.gain(Point::new(0.0, 0.0)) - 2.75).abs() < 1e-5);
+    // half way along the half diagonal (r² = 0.25)
+    let half = wp.gain(Point::new(75.0, 100.0)) as f64;
+    let want = 1.0 + 0.25 + 0.5 * 0.0625 + 0.25 * 0.25f64.powi(5);
+    assert!((half - want).abs() < 1e-5, "{half} vs {want}");
+    s.optics.converter_amount = 50.0;
+    let wp = Warp::from_settings(300.0, 400.0, &s, None);
+    assert!((wp.gain(Point::new(0.0, 0.0)) - 1.875).abs() < 1e-5);
+    s.optics.converter_amount = 0.0;
+    assert!(Warp::from_settings(300.0, 400.0, &s, None).is_identity(), "amount 0 = off");
+    s.optics.converter_amount = 100.0;
+    s.optics.vignetting = 100.0;
+    let both = Warp::from_settings(300.0, 400.0, &s, None).gain(Point::new(0.0, 0.0));
+    assert!((both - 2.75 * 2f32.powf(1.5)).abs() < 1e-3, "multiplies with the manual vignetting: {both}");
+    s.optics.vignetting = 0.0;
+    s.optics.lens_profile = true;
+    assert!((Warp::from_settings(300.0, 400.0, &s, None).gain(Point::new(0.0, 0.0)) - 2.75).abs() < 1e-5);
+    s.disabled_sections.push("optics".into());
+    assert!(Warp::from_settings(300.0, 400.0, &s, None).is_identity(), "the optics section's eye");
+}
+
+/// Coefficients from a file or an agent never give an unbounded or negative gain.
+#[test]
+fn converter_vignette_gain_is_bounded() {
+    let mut s = DevelopSettings::default();
+    s.optics.converter_k = [1e4, 1e4, 1e4, 1e4, 1e4];
+    s.optics.converter_amount = 200.0;
+    let g = Warp::from_settings(300.0, 200.0, &s, None).gain(Point::new(-50.0, -50.0));
+    assert!((g - 31.0).abs() < 1e-3, "{g}");
+    s.optics.converter_k = [-1e4, 0.0, 0.0, 0.0, 0.0];
+    let g = Warp::from_settings(300.0, 200.0, &s, None).gain(Point::new(0.0, 0.0));
+    assert!(g == 0.0, "{g}");
+    s.optics.converter_k = [f64::NAN, 1.0, 0.0, 0.0, 0.0];
+    assert!(Warp::from_settings(300.0, 200.0, &s, None).is_identity(), "non-finite coefficients are ignored");
+}
