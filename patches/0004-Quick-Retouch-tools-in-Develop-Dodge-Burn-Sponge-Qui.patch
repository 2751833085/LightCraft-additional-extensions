+#[test]
+fn object_selection_starts_the_object_mask_or_offers_the_model() {
+    let mut h = detail("panel.edit");
+    let stamp = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();
+    let dir = std::env::temp_dir().join(format!("lc-retouch-sam-{}-{stamp}", std::process::id()));
+    h.app.session.segmenter.dir = Some(dir.join("sam3"));
+    exec(&mut h, "tool.objectSelect", json!({}));
+    assert_eq!((h.app.ui.right, h.app.ui.view), (RightPanel::Masking, ViewMode::Detail));
+    if lightcraft_engine::segment::Segmenter::AVAILABLE && h.app.session.segmenter.remote_endpoint().is_none() {
+        assert!(
+            matches!(&h.app.ui.dialog, Some(Dialog::SamModel { then: Some((k, o)), .. }) if k == "object" && o == "new"),
+            "the model's download is offered, the Object mask to follow: {:?}",
+            h.app.ui.dialog.is_some()
+        );
+    } else {
+        // a build without SAM 3 says so; no empty Object mask is left behind
+        assert!(develop(&h).masks.is_empty());
+        assert!(h.app.ui.toast.is_some());
+    }
+    assert!(!dir.exists(), "nothing is downloaded or created");
+    assert_eq!(h.app.ui.retouch.selection, RetouchTool::ObjectSelect, "Shift+W starts from it next time");
+}
