+#[test]
+fn clone_stamp_opens_remove_in_clone_mode_and_alt_click_sets_the_source() {
+    let mut h = detail("panel.masking");
+    click(&mut h, "retouch:cloneStamp");
+    assert_eq!((h.app.ui.right, h.app.ui.view, h.app.ui.tool.as_str()), (RightPanel::Remove, ViewMode::Detail, "clone"));
+    frames(&mut h);
+    assert_eq!(tool(&h), Some(RetouchTool::CloneStamp));
+    assert!(h.app.widgets.iter().any(|(w, _)| w == "check:cloneAligned"), "Aligned shows in Clone mode");
+    // pressed again: still Clone (the panel command alone would close Remove)
+    exec(&mut h, "tool.cloneStamp", json!({}));
+    assert_eq!((h.app.ui.right, h.app.ui.tool.as_str()), (RightPanel::Remove, "clone"));
+
+    h.app.ui.remove_size = 0.03;
+    click_photo(&mut h, 0.3, 0.3, true);
+    assert!(develop(&h).spots.is_empty(), "⌥-click sets the source, it paints nothing");
+    let src = h.app.ui.retouch.clone_source.expect("a source");
+    assert!((src.at[0] - 0.3).abs() < 0.02 && (src.at[1] - 0.3).abs() < 0.02, "{src:?}");
+    frames(&mut h);
+    assert!(h.app.widgets.iter().any(|(w, _)| w == "cloneSource"), "the source is marked");
+
+    let near = |o: lightcraft_geom::Point, x: f64, y: f64| (o.x - x).abs() < 0.03 && (o.y - y).abs() < 0.03;
+    click_photo(&mut h, 0.6, 0.6, false);
+    let d = develop(&h);
+    assert_eq!(d.spots.len(), 1);
+    assert_eq!(d.spots[0].mode, SpotMode::Clone);
+    let o = d.spots[0].source_offset.expect("source");
+    assert!(near(o, -0.3, -0.3), "cloned from the ⌥-clicked point: {o:?}");
+    // Aligned: the next stroke keeps the offset
+    click_photo(&mut h, 0.75, 0.45, false);
+    let o = develop(&h).spots[1].source_offset.expect("source");
+    assert!(near(o, -0.3, -0.3), "aligned: {o:?}");
+    // not aligned: every stroke clones from the source point itself
+    h.app.ui.retouch.clone_aligned = false;
+    click_photo(&mut h, 0.5, 0.85, false);
+    let o = develop(&h).spots[2].source_offset.expect("source");
+    assert!(near(o, -0.2, -0.55), "from the source: {o:?}");
+}
