+/// The new keys are free in the default keymap: no UI command, alias or engine command has them.
+#[test]
+fn retouch_keys_share_no_binding() {
+    use crate::shortcuts::{ALIASES, parse};
+    let ours = ["tool.toningCycle", "tool.selectionCycle", "tool.cloneStamp", "tool.quickMask"];
+    let keyed: Vec<_> = crate::menus::ui_commands().filter(|c| ours.contains(&c.0)).map(|c| (c.0, c.2.and_then(parse))).collect();
+    assert_eq!(keyed.len(), ours.len());
+    let mut others: Vec<(String, _)> =
+        crate::menus::ui_commands().filter(|c| !ours.contains(&c.0)).filter_map(|c| Some((c.0.to_string(), c.2.and_then(parse)?))).collect();
+    others.extend(ALIASES.iter().filter_map(|(sc, id, _)| Some((format!("alias {id}"), parse(sc)?))));
+    others.extend(lightcraft_engine::command_specs().iter().filter_map(|c| Some((c.id.to_string(), c.shortcut.and_then(parse)?))));
+    for (id, k) in keyed {
+        let k = k.unwrap_or_else(|| panic!("{id} has a default key"));
+        assert!(!others.iter().any(|(_, o)| *o == k), "{id}'s key is taken by {:?}", others.iter().find(|(_, o)| *o == k));
+    }
+    // and every Quick Retouch command is in Window ▸ Tools
+    for id in crate::retouch_tools::COMMANDS {
+        assert!(crate::menus::ui_commands().any(|c| c.0 == *id && c.3 == "Window>Tools"), "{id}");
+    }
+}
