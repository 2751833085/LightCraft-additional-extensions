@@ -0,0 +1,391 @@
+//! The Masking panel's Quick Retouch tools (Dodge, Burn, Sponge, Quick / Object Selection, Clone
+//! Stamp, Quick Mask), driven through the control channel as a person clicks and types them.
+
+use std::time::Duration;
+
+use lightcraft_develop::{LocalAdjustments, MaskOp, MaskShape, SpotMode};
+use serde_json::{Value, json};
+
+use crate::headless::Headless;
+use crate::retouch_tools::{RetouchTool, current};
+use crate::state::{Dialog, RightPanel, ViewMode};
+use crate::{LightcraftApp, Services};
+
+const T: Duration = Duration::from_secs(20);
+
+fn detail(panel: &str) -> Headless {
+    let services = Services { png: None, ..Default::default() };
+    let app = LightcraftApp::new(lightcraft_engine::Session::with_demo(), services);
+    let mut h = Headless::new(app, [1200.0, 900.0], 1.0);
+    let r = h.request("ui.set", json!({"view": "detail"}), T);
+    assert_eq!(r["ok"], true, "{r}");
+    let r = h.request("engine.execute", json!({"command": panel}), T);
+    assert_eq!(r["ok"], true, "{r}");
+    h
+}
+
+fn exec(h: &mut Headless, command: &str, params: Value) -> Value {
+    let r = h.request("engine.execute", json!({"command": command, "params": params}), T);
+    assert_eq!(r["ok"], true, "{command}: {r}");
+    r["result"].clone()
+}
+
+fn develop(h: &Headless) -> lightcraft_develop::DevelopSettings {
+    let id = h.app.session.active().expect("active photo");
+    (*h.app.session.develop_of(id).unwrap_or_default()).clone()
+}
+
+fn click(h: &mut Headless, id: &str) {
+    let r = h.request("ui.clickWidget", json!({"id": id}), T);
+    assert_eq!(r["ok"], true, "{id}: {r}");
+}
+
+fn key(h: &mut Headless, k: &str, shift: bool) {
+    let r = h.request("ui.key", json!({"key": k, "shift": shift}), T);
+    assert_eq!(r["ok"], true, "{k}: {r}");
+}
+
+fn pointer(h: &mut Headless, events: Value, alt: bool) {
+    let r = h.request("ui.pointer", json!({"events": events, "alt": alt}), T);
+    assert_eq!(r["ok"], true, "{r}");
+}
+
+fn click_photo(h: &mut Headless, x: f64, y: f64, alt: bool) {
+    pointer(h, json!([{"kind": "down", "x": x, "y": y}, {"kind": "up", "x": x, "y": y}]), alt);
+}
+
+fn tool(h: &Headless) -> Option<RetouchTool> {
+    current(&h.app).map(|c| c.tool)
+}
+
+/// A few frames, so per-frame bookkeeping (the tool in use ending) has run.
+fn frames(h: &mut Headless) {
+    for _ in 0..3 {
+        h.step();
+    }
+}
+
+fn luminance(m: &lightcraft_develop::Mask) -> Option<(f64, f64)> {
+    m.components.iter().find_map(|c| match c.shape {
+        MaskShape::LuminanceRange { lo, hi, .. } if c.op == MaskOp::Intersect => Some((lo, hi)),
+        _ => None,
+    })
+}
+
+/// The coverage of mask `mask` at pixel (x, 50) of a 100×100 frame whose left half is a midtone
+/// (18 % grey) and right half a bright highlight.
+fn coverage(h: &Headless, mask: usize, x: usize) -> f32 {
+    use lightcraft_pipeline::{geometry::Frame, masks::evaluate_one};
+    use lightcraft_raster::{Plane, Rgb32f};
+    let d = develop(h);
+    let mut log_l = Plane::new(100, 100);
+    for (i, v) in log_l.data.iter_mut().enumerate() {
+        *v = if i % 100 < 50 { 0.18f32.log2() } else { 3.0 };
+    }
+    let a = evaluate_one(&d.masks[mask], &Frame::new(100, 100, &Default::default(), true), 100, 100, &Rgb32f::new(100, 100), &log_l, 0.0, None);
+    a.get(x, 50)
+}
+
+#[test]
+fn dodge_is_one_undo_step_an_exposure_brush_mask_limited_to_the_midtones() {
+    let mut h = detail("panel.masking");
+    // an effect remembered for new brush masks must not mix into Dodge
+    exec(&mut h, "mask.add", json!({"kind": "radial"}));
+    exec(&mut h, "mask.adjust", json!({"values": {"clarity": 40}}));
+    exec(&mut h, "mask.saveEffect", json!({"name": "Crisp"}));
+    exec(&mut h, "mask.delete", json!({}));
+    exec(&mut h, "mask.toolEffect", json!({"tool": "brush", "name": "Crisp"}));
+    exec(&mut h, "mask.add", json!({"kind": "brush"}));
+    assert_eq!(develop(&h).masks[0].adjust.clarity, 40.0, "new brush masks take the remembered effect");
+    exec(&mut h, "mask.delete", json!({}));
+    assert!(develop(&h).masks.is_empty());
+
+    h.app.ui.mask_overlay = true;
+    h.app.ui.brush_erase = true;
+    h.app.ui.tool.clear();
+    click(&mut h, "retouch:dodge");
+    let d = develop(&h);
+    assert_eq!(d.masks.len(), 1);
+    let m = &d.masks[0];
+    assert_eq!(m.name, "Dodge · Midtones");
+    assert_eq!(m.components.len(), 2);
+    assert!(matches!(m.components[0].shape, MaskShape::Brush { .. }) && m.components[0].op == MaskOp::Add);
+    assert_eq!(luminance(m), Some((0.35, 0.60)), "Midtones (the default) intersects a Luminance Range");
+    assert_eq!(m.adjust, LocalAdjustments { exposure: 1.0, ..Default::default() }, "+1 EV at 50 %, nothing else");
+    assert_eq!(h.app.session.active_mask, Some(m.id));
+    assert_eq!((h.app.ui.right, h.app.ui.view, h.app.ui.tool.as_str()), (RightPanel::Masking, ViewMode::Detail, "brush"));
+    assert!(!h.app.ui.brush_erase, "the brush paints");
+    assert!(!h.app.ui.mask_overlay, "dodging is judged on the photo");
+    frames(&mut h);
+    assert_eq!(tool(&h), Some(RetouchTool::Dodge));
+    assert!(h.app.widgets.iter().any(|(w, _)| w == "slider:retouch.exposure"), "the options bar shows Exposure");
+
+    // one undo step takes the whole mask away; redo brings it back whole
+    let made = develop(&h).masks;
+    exec(&mut h, "edit.undo", json!({}));
+    assert!(develop(&h).masks.is_empty());
+    exec(&mut h, "edit.redo", json!({}));
+    assert_eq!(develop(&h).masks, made);
+
+    // painting covers only the midtones
+    exec(&mut h, "mask.select", json!({"id": made[0].id}));
+    let r = h.request("ui.set", json!({"brushSize": 0.4, "brushFeather": 0.0, "brushFlow": 100.0}), T);
+    assert_eq!(r["ok"], true, "{r}");
+    click_photo(&mut h, 0.5, 0.5, false);
+    let d = develop(&h);
+    let MaskShape::Brush { strokes } = &d.masks[0].components[0].shape else { panic!("brush first") };
+    assert_eq!(strokes.len(), 1, "the stroke goes into the Dodge mask's brush");
+    assert!(coverage(&h, 0, 30) > 0.95, "midtone painted: {}", coverage(&h, 0, 30));
+    assert!(coverage(&h, 0, 70) < 0.05, "highlight left alone: {}", coverage(&h, 0, 70));
+}
+
+#[test]
+fn dodge_burn_and_sponge_options_set_the_mask() {
+    let mut h = detail("panel.masking");
+    exec(&mut h, "tool.dodge", json!({"exposure": 25, "range": "highlights"}));
+    let m = develop(&h).masks[0].clone();
+    assert_eq!((m.adjust.exposure, luminance(&m)), (0.5, Some((0.60, 1.0))));
+    assert_eq!(m.name, "Dodge · Highlights");
+    frames(&mut h);
+
+    // Range ▸ All drops the Luminance Range (one undo step), Shadows brings one back
+    click(&mut h, "button:retouchRange-all");
+    let m = develop(&h).masks[0].clone();
+    assert_eq!((m.components.len(), luminance(&m), m.name.as_str()), (1, None, "Dodge"));
+    exec(&mut h, "edit.undo", json!({}));
+    let m = develop(&h).masks[0].clone();
+    assert_eq!((luminance(&m), m.name.as_str()), (Some((0.60, 1.0)), "Dodge · Highlights"));
+    frames(&mut h);
+    click(&mut h, "button:retouchRange-shadows");
+    assert_eq!(luminance(&develop(&h).masks[0]), Some((0.0, 0.35)));
+    assert_eq!(h.app.ui.retouch.range, crate::retouch_tools::ToneRange::Shadows, "the range is remembered");
+
+    // Burn: the same mask darkening, with the remembered range
+    click(&mut h, "retouch:burn");
+    let d = develop(&h);
+    assert_eq!(d.masks.len(), 2);
+    let m = &d.masks[1];
+    assert_eq!((m.adjust.exposure, luminance(m), m.name.as_str()), (-0.5, Some((0.0, 0.35)), "Burn · Shadows"));
+    assert_eq!(m.adjust, LocalAdjustments { exposure: -0.5, ..Default::default() });
+    frames(&mut h);
+    assert_eq!(tool(&h), Some(RetouchTool::Burn));
+
+    // Sponge: local Saturation ∓ flow, no range
+    exec(&mut h, "tool.sponge", json!({"mode": "saturate", "flow": 30}));
+    let m = develop(&h).masks[2].clone();
+    assert_eq!(
+        (m.adjust, m.components.len(), m.name.as_str()),
+        (LocalAdjustments { saturation: 30.0, ..Default::default() }, 1, "Sponge · Saturate")
+    );
+    assert_eq!(h.app.ui.tool, "brush");
+    frames(&mut h);
+    click(&mut h, "button:retouchSponge-desaturate");
+    let m = develop(&h).masks[2].clone();
+    assert_eq!((m.adjust.saturation, m.name.as_str()), (-30.0, "Sponge · Desaturate"));
+    exec(&mut h, "edit.undo", json!({}));
+    let m = develop(&h).masks[2].clone();
+    assert_eq!((m.adjust.saturation, m.name.as_str()), (30.0, "Sponge · Saturate"), "the mode change is one undo step");
+
+    assert!(h.app.run("tool.dodge", json!({"range": "everything"})).is_err(), "an unknown range is refused");
+    assert_eq!(develop(&h).masks.len(), 3);
+}
+
+#[test]
+fn quick_selection_paints_with_auto_mask_and_gives_it_back() {
+    let mut h = detail("panel.masking");
+    h.app.ui.brush_auto_mask = false;
+    h.app.ui.brush_size = 0.03;
+    h.app.ui.mask_overlay = false;
+    click(&mut h, "retouch:quickSelect");
+    let d = develop(&h);
+    assert_eq!(d.masks.len(), 1);
+    let m = &d.masks[0];
+    assert_eq!(m.name, "Quick Selection");
+    assert!(matches!(&m.components[..], [c] if matches!(&c.shape, MaskShape::Brush { strokes } if strokes.is_empty())));
+    assert_eq!(m.adjust, LocalAdjustments::default(), "a selection first; its sliders come after");
+    assert!(h.app.ui.brush_auto_mask, "Auto Mask is on");
+    assert_eq!(h.app.ui.brush_size, crate::retouch_tools::QUICK_SELECT_SIZE, "a larger brush");
+    assert!(h.app.ui.mask_overlay, "the selection is shown");
+    assert_eq!(h.app.ui.tool, "brush");
+    frames(&mut h);
+    assert_eq!(tool(&h), Some(RetouchTool::QuickSelect));
+
+    click_photo(&mut h, 0.5, 0.5, false);
+    let d = develop(&h);
+    let MaskShape::Brush { strokes } = &d.masks[0].components[0].shape else { panic!("brush") };
+    assert!(strokes.len() == 1 && strokes[0].auto_mask, "the stroke sticks to edges");
+
+    // leaving the tool gives Auto Mask and the size back
+    exec(&mut h, "tool.none", json!({}));
+    frames(&mut h);
+    assert_eq!(tool(&h), None);
+    assert!(!h.app.ui.brush_auto_mask);
+    assert_eq!(h.app.ui.brush_size, 0.03);
+
+    // the new mask was one undo step (the stroke another)
+    exec(&mut h, "edit.undo", json!({}));
+    exec(&mut h, "edit.undo", json!({}));
+    assert!(develop(&h).masks.is_empty());
+}
