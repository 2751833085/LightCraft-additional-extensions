@@ -0,0 +1,149 @@
+//! The Masking panel's Quick Retouch row (Dodge, Burn, Sponge, Quick / Object Selection, Clone
+//! Stamp, Quick Mask) and the options of the tool in use. The tools are `crate::retouch_tools`.
+
+use lightcraft_develop::{ControlSpec, Section, Track};
+use serde_json::json;
+
+use super::edit::apply_slider_out;
+use crate::LightcraftApp;
+use crate::icons::Icon;
+use crate::retouch_tools::{self as rt, RetouchTool, SpongeMode, ToneRange};
+use crate::theme::Tokens;
+use crate::widgets::{icon_button, register, slider, text_button};
+
+/// "Dodge (Shift+B)": a name with the key of its command (or of its group's cycle).
+fn with_key(app: &LightcraftApp, ui: &egui::Ui, name: &str, ids: &[&str]) -> String {
+    let mac = ui.ctx().os() == egui::os::OperatingSystem::Mac;
+    let name = crate::i18n::tr(name);
+    match ids.iter().find_map(|id| crate::shortcuts::shortcut_of(&app.ui.settings.keymap, id)) {
+        Some(sc) => format!("{name} ({})", crate::menubar::shortcut_text(sc, mac)),
+        None => name.to_string(),
+    }
+}
+
+/// The row's icon of each tool (Photoshop-like glyphs from the icon set).
+fn icon(tool: RetouchTool) -> Icon {
+    match tool {
+        RetouchTool::Dodge => Icon::Sun,
+        RetouchTool::Burn => Icon::Moon,
+        RetouchTool::Sponge => Icon::GradeAll,
+        RetouchTool::QuickSelect => Icon::Brush,
+        RetouchTool::ObjectSelect => Icon::Subject,
+        RetouchTool::CloneStamp => Icon::Target,
+    }
+}
+
+/// One line of tool buttons (the name and key on hover; it wraps in a narrow panel, so the
+/// Create New Mask tiles below move down as little as possible), then the options of the tool
+/// in use.
+pub fn show(app: &mut LightcraftApp, ui: &mut egui::Ui) {
+    let t = Tokens::get(ui.ctx());
+    let current = rt::current(app).map(|c| c.tool);
+    egui::Frame::NONE.inner_margin(egui::Margin { left: 24, right: 22, top: 0, bottom: 4 }).show(ui, |ui| {
+        ui.horizontal_wrapped(|ui| {
+            ui.spacing_mut().item_spacing = egui::vec2(2.0, 2.0);
+            let title = ui.label(egui::RichText::new(crate::i18n::tr("Quick Retouch")).color(t.text_dim));
+            register(ui, "retouch:title", title.rect);
+            ui.add_space(4.0);
+            for tool in RetouchTool::ALL {
+                let ids: Vec<&str> = [tool.command()].into_iter().chain(tool.cycle_command()).collect();
+                let tip = with_key(app, ui, tool.label(), &ids);
+                let b = icon_button(ui, &format!("retouch-{}", tool.id()), icon(tool), egui::vec2(26.0, 24.0), current == Some(tool), true, &tip);
+                register(ui, format!("retouch:{}", tool.id()), b.rect);
+                if b.clicked()
+                    && let Err(e) = app.run(tool.command(), json!({}))
+                {
+                    app.toast(ui.ctx(), e);
+                }
+            }
+            let on = app.ui.retouch.quick_mask.is_some();
+            let tip = with_key(app, ui, "Quick Mask", &["tool.quickMask"]);
+            let b = icon_button(ui, "retouch-quickMask", Icon::Mask, egui::vec2(26.0, 24.0), on, true, &tip);
+            register(ui, "retouch:quickMask", b.rect);
+            if b.clicked()
+                && let Err(e) = app.run("tool.quickMask", json!({}))
+            {
+                app.toast(ui.ctx(), e);
+            }
+        });
+        // the tool in use, by name (the icons alone don't say)
+        if let Some(tool) = current {
+            ui.label(egui::RichText::new(crate::i18n::tr(tool.label())).color(t.text_label).size(11.5));
+        }
+    });
+    options(app, ui);
+}
+
+const fn percent(id: &'static str, label: &'static str) -> ControlSpec {
+    ControlSpec { id, label, section: Section::Light, min: 1.0, max: 100.0, default: 50.0, step: 1.0, decimals: 0, track: Track::Plain }
+}
+
+const EXPOSURE: ControlSpec = percent("retouch.exposure", "Exposure");
+const FLOW: ControlSpec = percent("retouch.flow", "Flow");
+
+/// The options bar of the painting tool in use: Range and Exposure (Dodge, Burn), Mode and Flow
+/// (Sponge), Select Subject (Quick Selection). They edit its mask.
+fn options(app: &mut LightcraftApp, ui: &mut egui::Ui) {
+    let Some((c, m)) = rt::current_mask(app) else { return };
+    let t = Tokens::get(ui.ctx());
+    match c.tool {
+        RetouchTool::Dodge | RetouchTool::Burn => {
+            choice_row(ui, &t, "Range", |ui| {
+                for r in ToneRange::ALL {
+                    if text_button(ui, &format!("retouchRange-{}", r.id()), r.label(), app.ui.retouch.range == r).clicked()
+                        && let Err(e) = rt::set_range(app, r)
+                    {
+                        app.toast(ui.ctx(), e);
+                    }
+                }
+            });
+            // the mask's own Exposure, as Photoshop's percentage
+            let v = (m.adjust.exposure.abs() / rt::EV_AT_FULL * 100.0).clamp(1.0, 100.0);
+            let out = slider(ui, &EXPOSURE, v, true, Some(crate::i18n::tr_ctx("retouch", "Exposure")));
+            let sign = if c.tool == RetouchTool::Burn { -1.0 } else { 1.0 };
+            apply_slider_out(app, &EXPOSURE, out, |app, v| {
+                app.ui.retouch.exposure = v as f32;
+                app.run("mask.adjust", json!({"id": m.id, "values": {"exposure": sign * rt::exposure_ev(v as f32)}}))
+            });
+        }
+        RetouchTool::Sponge => {
+            choice_row(ui, &t, "Mode", |ui| {
+                for mode in [SpongeMode::Desaturate, SpongeMode::Saturate] {
+                    if text_button(ui, &format!("retouchSponge-{}", mode.id()), mode.label(), app.ui.retouch.sponge_mode == mode).clicked()
+                        && let Err(e) = rt::set_sponge_mode(app, mode)
+                    {
+                        app.toast(ui.ctx(), e);
+                    }
+                }
+            });
+            let v = m.adjust.saturation.abs().clamp(1.0, 100.0);
+            let out = slider(ui, &FLOW, v, true, None);
+            let sign = if m.adjust.saturation > 0.0 { 1.0 } else { -1.0 };
+            apply_slider_out(app, &FLOW, out, |app, v| {
+                app.ui.retouch.flow = v as f32;
+                app.run("mask.adjust", json!({"id": m.id, "values": {"saturation": sign * v}}))
+            });
+        }
+        RetouchTool::QuickSelect => {
+            egui::Frame::NONE.inner_margin(egui::Margin { left: 24, right: 22, top: 0, bottom: 6 }).show(ui, |ui| {
+                if text_button(ui, "retouchSelectSubject", "Select Subject", false).clicked()
+                    && let Err(e) = app.run("mask.addComponent", json!({"id": m.id, "op": "add", "kind": "subject"}))
+                {
+                    app.toast(ui.ctx(), e);
+                }
+            });
+        }
+        RetouchTool::ObjectSelect | RetouchTool::CloneStamp => {}
+    }
+}
+
+/// A label and its buttons, wrapping in a narrow panel.
+fn choice_row(ui: &mut egui::Ui, t: &Tokens, label: &str, add: impl FnOnce(&mut egui::Ui)) {
+    egui::Frame::NONE.inner_margin(egui::Margin { left: 24, right: 22, top: 0, bottom: 4 }).show(ui, |ui| {
+        ui.horizontal_wrapped(|ui| {
+            ui.spacing_mut().item_spacing.y = 6.0;
+            ui.label(egui::RichText::new(crate::i18n::tr(label)).color(t.text_dim));
+            add(ui);
+        });
+    });
+}
