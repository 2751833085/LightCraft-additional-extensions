+/// Clone mode: ⌥/Alt-click sets the source the next strokes clone from (Photoshop's Clone Stamp);
+/// the source shows as a crosshair. Whether the click was used up.
+fn clone_source_click(app: &mut LightcraftApp, ui: &egui::Ui, resp: &egui::Response, map: &CanvasMap, p: &egui::Painter) -> bool {
+    if app.ui.tool != "clone" {
+        return false;
+    }
+    let used = resp.clicked() && ui.input(|i| i.modifiers.alt);
+    if used && let Some(q) = resp.interact_pointer_pos() {
+        let n = map.norm(q);
+        crate::retouch_tools::set_clone_source(app, [n.x, n.y]);
+        app.toast(ui.ctx(), crate::i18n::tr("Clone source set · paint to clone from it"));
+    }
+    if let Some(src) = crate::retouch_tools::clone_source(app) {
+        let c = map.screen(Point::new(src.at[0], src.at[1]));
+        let stroke = Stroke::new(1.5, Color32::WHITE);
+        p.circle_stroke(c, 7.0, stroke);
+        p.line_segment([c - vec2(11.0, 0.0), c + vec2(11.0, 0.0)], stroke);
+        p.line_segment([c - vec2(0.0, 11.0), c + vec2(0.0, 11.0)], stroke);
+        register(ui, "cloneSource", Rect::from_center_size(c, vec2(14.0, 14.0)));
     }
+    used
 }
 
