diff --git a/crates/ui-egui/src/retouch_tools.rs b/crates/ui-egui/src/retouch_tools.rs
new file mode 100644
index 000000000..56583b3ec
--- /dev/null
+++ b/crates/ui-egui/src/retouch_tools.rs
@@ -0,0 +1,636 @@
+//! Photoshop-style quick retouch tools in Develop, built from what LightCraft already has (no new
+//! mask kinds or pipeline work): each one is a short sequence of existing commands.
+//!
+//! - Dodge / Burn: a new brush mask with local Exposure ± (Exposure % → ±2 EV at 100 %), optionally
+//!   intersected with a Luminance Range (Shadows / Midtones / Highlights), the brush ready.
+//! - Sponge: a new brush mask with local Saturation ∓ Flow % (Desaturate / Saturate).
+//! - Quick Selection: a new, empty brush mask with Auto Mask on, a larger brush and the overlay
+//!   shown (Auto Mask and the size come back when the tool is left).
+//! - Object Selection: the Masking panel's Object (SAM 3) mask, with its model download offer.
+//! - Clone Stamp: the Remove panel in Clone mode; ⌥/Alt-click on the photo sets the source.
+//! - Quick Mask: a red 50 % overlay with the brush (the previous overlay settings come back).
+//!
+//! Creating a mask is one undo step: the steps run inside `develop.beginInteraction` /
+//! `develop.endInteraction` (cancelled on an error).
+
+use lightcraft_develop::{LocalAdjustments, MaskOp, MaskShape};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+
+use crate::LightcraftApp;
+use crate::state::{Dialog, RightPanel, ViewMode};
+
+/// The tools of the Quick Retouch row.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub enum RetouchTool {
+    #[default]
+    Dodge,
+    Burn,
+    Sponge,
+    QuickSelect,
+    ObjectSelect,
+    CloneStamp,
+}
+
+impl RetouchTool {
+    pub const ALL: [RetouchTool; 6] = [Self::Dodge, Self::Burn, Self::Sponge, Self::QuickSelect, Self::ObjectSelect, Self::CloneStamp];
+
+    /// The UI command that starts the tool.
+    pub fn command(self) -> &'static str {
+        match self {
+            Self::Dodge => "tool.dodge",
+            Self::Burn => "tool.burn",
+            Self::Sponge => "tool.sponge",
+            Self::QuickSelect => "tool.quickSelect",
+            Self::ObjectSelect => "tool.objectSelect",
+            Self::CloneStamp => "tool.cloneStamp",
+        }
+    }
+
+    /// The tool's name (English source of the translation).
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Dodge => "Dodge",
+            Self::Burn => "Burn",
+            Self::Sponge => "Sponge",
+            Self::QuickSelect => "Quick Selection",
+            Self::ObjectSelect => "Object Selection",
+            Self::CloneStamp => "Clone Stamp",
+        }
+    }
+
+    /// The id its button is registered under (`button:retouch-<id>`).
+    pub fn id(self) -> &'static str {
+        match self {
+            Self::Dodge => "dodge",
+            Self::Burn => "burn",
+            Self::Sponge => "sponge",
+            Self::QuickSelect => "quickSelect",
+            Self::ObjectSelect => "objectSelect",
+            Self::CloneStamp => "cloneStamp",
+        }
+    }
+
+    /// The command whose key steps through the tool's group (Shift+B, Shift+W).
+    pub fn cycle_command(self) -> Option<&'static str> {
+        match self {
+            Self::Dodge | Self::Burn | Self::Sponge => Some("tool.toningCycle"),
+            Self::QuickSelect | Self::ObjectSelect => Some("tool.selectionCycle"),
+            Self::CloneStamp => None,
+        }
+    }
+
+    fn toning(self) -> bool {
+        matches!(self, Self::Dodge | Self::Burn | Self::Sponge)
+    }
+
+    fn selection(self) -> bool {
+        matches!(self, Self::QuickSelect | Self::ObjectSelect)
+    }
+}
+
+/// Which tones Dodge and Burn act on: the brush mask intersected with a Luminance Range.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub enum ToneRange {
+    All,
+    Shadows,
+    #[default]
+    Midtones,
+    Highlights,
+}
+
+impl ToneRange {
+    pub const ALL: [ToneRange; 4] = [Self::All, Self::Shadows, Self::Midtones, Self::Highlights];
+
+    pub fn id(self) -> &'static str {
+        match self {
+            Self::All => "all",
+            Self::Shadows => "shadows",
+            Self::Midtones => "midtones",
+            Self::Highlights => "highlights",
+        }
+    }
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::All => "All",
+            Self::Shadows => "Shadows",
+            Self::Midtones => "Midtones",
+            Self::Highlights => "Highlights",
+        }
+    }
+
+    fn parse(s: &str) -> Option<Self> {
+        Self::ALL.into_iter().find(|r| r.id() == s)
+    }
+
+    /// The Luminance Range (lo, hi) on its 0..1 scale (−8..+4 EV, white near 0.667): shadows up
+    /// to about sRGB 30 %, midtones to about 78 %, highlights above. `None` for All.
+    pub fn band(self) -> Option<(f64, f64)> {
+        match self {
+            Self::All => None,
+            Self::Shadows => Some((0.0, 0.35)),
+            Self::Midtones => Some((0.35, 0.60)),
+            Self::Highlights => Some((0.60, 1.0)),
+        }
+    }
+}
+
+/// The Luminance Range's falloff on both sides.
+pub const RANGE_FEATHER: f64 = 0.1;
+/// Local exposure (EV) of Dodge / Burn at 100 %: the default 50 % is ±1 EV.
+pub const EV_AT_FULL: f64 = 2.0;
+/// The smallest brush Quick Selection paints with (fraction of the long edge).
+pub const QUICK_SELECT_SIZE: f32 = 0.08;
+/// Quick Mask's overlay: Photoshop's red at 50 %.
+pub const QUICK_MASK_COLOR: [u8; 3] = [230, 30, 40];
+pub const QUICK_MASK_OPACITY: f32 = 50.0;
+
+/// Sponge: take colour out of, or put it into, what is painted.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub enum SpongeMode {
+    #[default]
+    Desaturate,
+    Saturate,
+}
+
+impl SpongeMode {
+    pub fn id(self) -> &'static str {
+        match self {
+            Self::Desaturate => "desaturate",
+            Self::Saturate => "saturate",
+        }
+    }
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Desaturate => "Desaturate",
+            Self::Saturate => "Saturate",
+        }
+    }
+
+    fn sign(self) -> f64 {
+        match self {
+            Self::Desaturate => -1.0,
+            Self::Saturate => 1.0,
+        }
+    }
+}
+
+/// The tool in use: which, on which photo, and (painting tools) its mask.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Current {
+    pub tool: RetouchTool,
+    pub photo: u64,
+    pub mask: Option<u32>,
+}
+
+/// The overlay as it was before Quick Mask turned on.
+#[derive(Clone, Debug, PartialEq)]
+pub struct OverlayRestore {
+    pub on: bool,
+    pub mode: String,
+    pub color: [u8; 3],
+    pub opacity: f32,
+}
+
+/// Clone Stamp's source, set by ⌥/Alt-clicking the photo; with Aligned, the offset of the first
+/// stroke after it is kept for the following ones.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct CloneSource {
+    pub photo: u64,
+    pub at: [f64; 2],
+    pub offset: Option<[f64; 2]>,
+}
+
+/// The Quick Retouch options (saved) and the tool in use (not saved).
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+pub struct RetouchState {
+    /// The Dodge / Burn / Sponge tool Shift+B starts from.
+    pub toning: RetouchTool,
+    /// The Quick / Object Selection tool Shift+W starts from.
+    pub selection: RetouchTool,
+    pub range: ToneRange,
+    /// Dodge / Burn Exposure, 1..100 %.
+    pub exposure: f32,
+    pub sponge_mode: SpongeMode,
+    /// Sponge Flow, 1..100 %: the local Saturation it sets.
+    pub flow: f32,
+    /// Clone Stamp: the source moves with the brush after the first stroke.
+    pub clone_aligned: bool,
+    #[serde(skip)]
+    pub current: Option<Current>,
+    /// Auto Mask and brush size before Quick Selection changed them.
+    #[serde(skip)]
+    pub quick_select_restore: Option<(bool, f32)>,
+    /// On while Quick Mask is: the overlay to go back to.
+    #[serde(skip)]
+    pub quick_mask: Option<OverlayRestore>,
+    #[serde(skip)]
+    pub clone_source: Option<CloneSource>,
+}
+
+impl Default for RetouchState {
+    fn default() -> Self {
+        Self {
+            toning: RetouchTool::Dodge,
+            selection: RetouchTool::QuickSelect,
+            range: ToneRange::Midtones,
+            exposure: 50.0,
+            sponge_mode: SpongeMode::Desaturate,
+            flow: 50.0,
+            clone_aligned: true,
+            current: None,
+            quick_select_restore: None,
+            quick_mask: None,
+            clone_source: None,
+        }
+    }
+}
+
+/// The local adjustments of a tool's new mask: everything else at zero, so an effect remembered for
+/// new brush masks does not mix in.
+pub fn effect(tool: RetouchTool, s: &RetouchState) -> LocalAdjustments {
+    let mut a = LocalAdjustments::default();
+    match tool {
+        RetouchTool::Dodge => a.exposure = exposure_ev(s.exposure),
+        RetouchTool::Burn => a.exposure = -exposure_ev(s.exposure),
+        RetouchTool::Sponge => a.saturation = s.sponge_mode.sign() * f64::from(s.flow.clamp(1.0, 100.0)),
+        _ => {}
+    }
+    a
+}
+
+/// Exposure % as local EV (positive).
+pub fn exposure_ev(percent: f32) -> f64 {
+    f64::from(percent.clamp(1.0, 100.0)) / 100.0 * EV_AT_FULL
+}
+
+/// A new mask's name: the tool, and its range or mode.
+fn mask_name(tool: RetouchTool, s: &RetouchState) -> String {
+    let tr = crate::i18n::tr;
+    match tool {
+        RetouchTool::Dodge | RetouchTool::Burn if s.range != ToneRange::All => format!("{} · {}", tr(tool.label()), tr(s.range.label())),
+        RetouchTool::Sponge => format!("{} · {}", tr(tool.label()), tr(s.sponge_mode.label())),
+        _ => tr(tool.label()).to_string(),
+    }
+}
+
+/// The ids of the Quick Retouch commands (`tool.*` ones are enabled with an active photo).
+pub const COMMANDS: &[&str] = &[
+    "tool.dodge",
+    "tool.burn",
+    "tool.sponge",
+    "tool.toningCycle",
+    "tool.quickSelect",
+    "tool.objectSelect",
+    "tool.selectionCycle",
+    "tool.cloneStamp",
+    "tool.quickMask",
+];
+
+/// Run a Quick Retouch command; `None`: `id` is not one.
+pub fn command(app: &mut LightcraftApp, ctx: &egui::Context, id: &str, p: &Value) -> Option<Result<Value, String>> {
+    if !COMMANDS.contains(&id) {
+        return None;
+    }
+    if app.session.active().is_none() {
+        return Some(Err(format!("{id}: no active photo")));
+    }
+    Some(match id {
+        "tool.dodge" => options(app, id, p).and_then(|_| start(app, ctx, RetouchTool::Dodge)),
+        "tool.burn" => options(app, id, p).and_then(|_| start(app, ctx, RetouchTool::Burn)),
+        "tool.sponge" => options(app, id, p).and_then(|_| start(app, ctx, RetouchTool::Sponge)),
+        "tool.quickSelect" => start(app, ctx, RetouchTool::QuickSelect),
+        "tool.objectSelect" => start(app, ctx, RetouchTool::ObjectSelect),
+        "tool.cloneStamp" => start(app, ctx, RetouchTool::CloneStamp),
+        "tool.toningCycle" => {
+            let next = cycle(app, RetouchTool::toning, app.ui.retouch.toning, |t| match t {
+                RetouchTool::Dodge => RetouchTool::Burn,
+                RetouchTool::Burn => RetouchTool::Sponge,
+                _ => RetouchTool::Dodge,
+            });
+            start(app, ctx, next)
+        }
+        "tool.selectionCycle" => {
+            let next = cycle(app, RetouchTool::selection, app.ui.retouch.selection, |t| match t {
+                RetouchTool::QuickSelect => RetouchTool::ObjectSelect,
+                _ => RetouchTool::QuickSelect,
+            });
+            start(app, ctx, next)
+        }
+        _ => quick_mask(app, ctx, p),
+    })
+}
+
+/// The tool a group's key starts: the next one while a tool of the group is in use, else the one
+/// used last.
+fn cycle(app: &LightcraftApp, group: fn(RetouchTool) -> bool, last: RetouchTool, next: fn(RetouchTool) -> RetouchTool) -> RetouchTool {
+    match app.ui.retouch.current.filter(|c| group(c.tool) && alive(app, c)) {
+        Some(c) => next(c.tool),
+        None => last,
+    }
+}
+
+/// `{range?, exposure?}` (Dodge / Burn) and `{mode?, flow?}` (Sponge): remembered for the next time.
+fn options(app: &mut LightcraftApp, id: &str, p: &Value) -> Result<(), String> {
+    let s = &mut app.ui.retouch;
+    if let Some(v) = p.get("range").filter(|v| !v.is_null()) {
+        s.range = v.as_str().and_then(ToneRange::parse).ok_or_else(|| format!("{id}: unknown range {v} (all|shadows|midtones|highlights)"))?;
+    }
+    if let Some(v) = p.get("exposure").filter(|v| !v.is_null()) {
+        s.exposure = v.as_f64().ok_or_else(|| format!("{id}: `exposure` is a percentage (1..100)"))?.clamp(1.0, 100.0) as f32;
+    }
+    if let Some(v) = p.get("mode").filter(|v| !v.is_null()) {
+        s.sponge_mode = match v.as_str() {
+            Some("desaturate") => SpongeMode::Desaturate,
+            Some("saturate") => SpongeMode::Saturate,
+            _ => return Err(format!("{id}: unknown mode {v} (desaturate|saturate)")),
+        };
+    }
+    if let Some(v) = p.get("flow").filter(|v| !v.is_null()) {
+        s.flow = v.as_f64().ok_or_else(|| format!("{id}: `flow` is a percentage (1..100)"))?.clamp(1.0, 100.0) as f32;
+    }
+    Ok(())
+}
+
+/// Start `tool` on the active photo.
+fn start(app: &mut LightcraftApp, ctx: &egui::Context, tool: RetouchTool) -> Result<Value, String> {
+    end_current(app);
+    let photo = app.session.active().map(|p| p.0).ok_or("no active photo")?;
+    if tool.toning() {
+        app.ui.retouch.toning = tool;
+    } else if tool.selection() {
+        app.ui.retouch.selection = tool;
+    }
+    let mut mask = None;
+    match tool {
+        RetouchTool::Dodge | RetouchTool::Burn | RetouchTool::Sponge => {
+            let range = if tool == RetouchTool::Sponge { None } else { app.ui.retouch.range.band() };
+            let id = new_mask(app, tool, range)?;
+            mask = Some(id);
+            app.run("tool.brush", json!({}))?;
+            app.ui.brush_erase = false;
+            let hint = match tool {
+                RetouchTool::Dodge => "Paint to lighten · ⌥ erases",
+                RetouchTool::Burn => "Paint to darken · ⌥ erases",
+                _ if app.ui.retouch.sponge_mode == SpongeMode::Saturate => "Paint to saturate · ⌥ erases",
+                _ => "Paint to desaturate · ⌥ erases",
+            };
+            app.toast(ctx, crate::i18n::tr(hint));
+        }
+        RetouchTool::QuickSelect => {
+            let id = new_mask(app, tool, None)?;
+            mask = Some(id);
+            app.run("tool.brush", json!({}))?;
+            app.ui.retouch.quick_select_restore = Some((app.ui.brush_auto_mask, app.ui.brush_size));
+            app.ui.brush_erase = false;
+            app.ui.brush_auto_mask = true;
+            app.ui.brush_size = app.ui.brush_size.max(QUICK_SELECT_SIZE);
+            // the selection shows while it is painted (the new mask's adjustment hid the overlay)
+            app.ui.mask_overlay = true;
+            app.toast(ctx, crate::i18n::tr("Paint over what to select · ⌥ erases"));
+        }
+        RetouchTool::ObjectSelect => {
+            crate::panels::modules::leave_print(app);
+            app.ui.right = RightPanel::Masking;
+            app.ui.view = ViewMode::Detail;
+            crate::panels::masking::start_object(app, ctx, "new");
+        }
+        RetouchTool::CloneStamp => {
+            if app.ui.right != RightPanel::Remove {
+                app.run("panel.remove", json!({}))?;
+            }
+            app.ui.right = RightPanel::Remove;
+            app.ui.view = ViewMode::Detail;
+            app.ui.tool = "clone".into();
+            app.toast(ctx, crate::i18n::tr("Alt-click (⌥-click) sets the clone source"));
+        }
+    }
+    app.ui.retouch.current = Some(Current { tool, photo, mask });
+    Ok(json!({"tool": tool.id(), "mask": mask}))
+}
+
+/// A new brush mask for `tool` with its effect (and the Luminance Range `range` intersected), as
+/// one undo step. The mask selected before is selected again when a step fails.
+fn new_mask(app: &mut LightcraftApp, tool: RetouchTool, range: Option<(f64, f64)>) -> Result<u32, String> {
+    let before = app.session.active_mask;
+    app.run("develop.beginInteraction", json!({"label": tool.label()}))?;
+    match new_mask_steps(app, tool, range) {
+        Ok(id) => {
+            app.run("develop.endInteraction", json!({}))?;
+            Ok(id)
+        }
+        Err(e) => {
+            let _ = app.run("develop.cancelInteraction", json!({}));
+            app.session.active_mask = before;
+            Err(e)
+        }
+    }
+}
+
+fn new_mask_steps(app: &mut LightcraftApp, tool: RetouchTool, range: Option<(f64, f64)>) -> Result<u32, String> {
+    let name = mask_name(tool, &app.ui.retouch);
+    let r = app.run("mask.add", json!({"kind": "brush", "name": name}))?;
+    let id = r.get("activeMask").and_then(Value::as_u64).and_then(|v| u32::try_from(v).ok()).ok_or("mask.add: no new mask")?;
+    if let Some((lo, hi)) = range {
+        app.run(
+            "mask.addComponent",
+            json!({"id": id, "op": "intersect", "kind": "luminanceRange", "lo": lo, "hi": hi, "loFeather": RANGE_FEATHER, "hiFeather": RANGE_FEATHER}),
+        )?;
+    }
+    let values = serde_json::to_value(effect(tool, &app.ui.retouch)).map_err(|e| e.to_string())?;
+    app.run("mask.adjust", json!({"id": id, "values": values}))?;
+    Ok(id)
+}
+
+/// Q: Quick Mask `{on?}` (toggles when omitted). On: a red 50 % colour overlay of the selected mask
+/// (a new brush mask when none is selected) with the brush; off: the overlay as it was.
+fn quick_mask(app: &mut LightcraftApp, ctx: &egui::Context, p: &Value) -> Result<Value, String> {
+    let on = match p.get("on").filter(|v| !v.is_null()) {
+        None => app.ui.retouch.quick_mask.is_none(),
+        Some(Value::Bool(b)) => *b,
+        Some(other) => return Err(format!("tool.quickMask: `on` must be true or false, not {other}")),
+    };
+    let name = crate::i18n::tr("Quick Mask");
+    if !on {
+        if let Some(r) = app.ui.retouch.quick_mask.take() {
+            app.ui.mask_overlay = r.on;
+            app.ui.mask_overlay_mode = r.mode;
+            app.ui.mask_overlay_color = r.color;
+            app.ui.mask_overlay_opacity = r.opacity;
+            app.toast(ctx, crate::i18n::tr_format!("{name} Off", name = name));
+        }
+        return Ok(json!({"on": false}));
+    }
+    let saved = app.ui.retouch.quick_mask.clone().unwrap_or_else(|| OverlayRestore {
+        on: app.ui.mask_overlay,
+        mode: app.ui.mask_overlay_mode.clone(),
+        color: app.ui.mask_overlay_color,
+        opacity: app.ui.mask_overlay_opacity,
+    });
+    let selected =
+        app.session.active().and_then(|id| app.session.develop_of(id)).is_some_and(|d| d.masks.iter().any(|m| Some(m.id) == app.session.active_mask));
+    if !selected {
+        app.run("mask.add", json!({"kind": "brush", "name": name}))?;
+    }
+    app.run("tool.brush", json!({}))?;
+    app.ui.brush_erase = false;
+    app.ui.retouch.quick_mask = Some(saved);
+    app.ui.mask_overlay = true;
+    app.ui.mask_overlay_mode = lightcraft_pipeline::MaskView::Color.name().into();
+    app.ui.mask_overlay_color = QUICK_MASK_COLOR;
+    app.ui.mask_overlay_opacity = QUICK_MASK_OPACITY;
+    app.toast(ctx, crate::i18n::tr_format!("{name} On", name = name));
+    Ok(json!({"on": true, "mask": app.session.active_mask}))
+}
+
+/// Whether the tool `c` started is still the one in use.
+pub fn alive(app: &LightcraftApp, c: &Current) -> bool {
+    if app.session.active().map(|p| p.0) != Some(c.photo) {
+        return false;
+    }
+    match c.tool {
+        RetouchTool::Dodge | RetouchTool::Burn | RetouchTool::Sponge | RetouchTool::QuickSelect => {
+            app.ui.right == RightPanel::Masking && app.ui.tool == "brush" && app.session.active_mask == c.mask
+        }
+        RetouchTool::ObjectSelect => app.ui.tool == "object" || matches!(app.ui.dialog, Some(Dialog::SamModel { .. })),
+        RetouchTool::CloneStamp => app.ui.right == RightPanel::Remove && app.ui.tool == "clone",
+    }
+}
+
+/// The tool in use, while it is.
+pub fn current(app: &LightcraftApp) -> Option<Current> {
+    app.ui.retouch.current.filter(|c| alive(app, c))
+}
+
+/// Leave the tool in use: Quick Selection's Auto Mask and brush size come back.
+fn end_current(app: &mut LightcraftApp) {
+    app.ui.retouch.current = None;
+    if let Some((auto, size)) = app.ui.retouch.quick_select_restore.take() {
+        app.ui.brush_auto_mask = auto;
+        app.ui.brush_size = size;
+    }
+}
+
+/// Once a frame, before anything draws: a tool left (another mask, panel, tool or photo) ends.
+pub fn before_frame(app: &mut LightcraftApp) {
+    if app.ui.retouch.current.is_some_and(|c| !alive(app, &c)) {
+        end_current(app);
+    }
+}
+
+// ------------------------------------------------------------------------ options of the mask in use
+
+/// The mask the painting tool in use paints into, on the active photo.
+pub fn current_mask(app: &LightcraftApp) -> Option<(Current, lightcraft_develop::Mask)> {
+    let c = current(app)?;
+    let id = c.mask?;
+    let d = app.session.active().and_then(|p| app.session.develop_of(p))?;
+    let m = d.masks.iter().find(|m| m.id == id)?.clone();
+    Some((c, m))
+}
+
+/// The index of the Luminance Range a Dodge / Burn mask is intersected with.
+fn range_component(m: &lightcraft_develop::Mask) -> Option<usize> {
+    m.components.iter().position(|c| c.op == MaskOp::Intersect && matches!(c.shape, MaskShape::LuminanceRange { .. }))
+}
+
+/// Dodge / Burn Range: remembered, and the mask in use follows (one undo step).
+pub fn set_range(app: &mut LightcraftApp, range: ToneRange) -> Result<(), String> {
+    let old = app.ui.retouch.clone();
+    app.ui.retouch.range = range;
+    let Some((c, m)) = current_mask(app).filter(|(c, _)| matches!(c.tool, RetouchTool::Dodge | RetouchTool::Burn)) else { return Ok(()) };
+    let overlay = app.ui.mask_overlay;
+    app.run("develop.beginInteraction", json!({"label": "Range"}))?;
+    let r = (|| {
+        match (range_component(&m), range.band()) {
+            (Some(k), None) => app.run("mask.component", json!({"id": m.id, "component": k, "action": "delete"})).map(|_| ()),
+            (Some(k), Some((lo, hi))) => {
+                let shape = MaskShape::LuminanceRange { lo, hi, lo_feather: RANGE_FEATHER, hi_feather: RANGE_FEATHER };
+                app.run("mask.update", json!({"id": m.id, "component": k, "shape": shape})).map(|_| ())
+            }
+            (None, Some((lo, hi))) => app
+                .run(
+                    "mask.addComponent",
+                    json!({"id": m.id, "op": "intersect", "kind": "luminanceRange", "lo": lo, "hi": hi, "loFeather": RANGE_FEATHER, "hiFeather": RANGE_FEATHER}),
+                )
+                .map(|_| ()),
+            (None, None) => Ok(()),
+        }?;
+        rename_if_automatic(app, &m, c.tool, &old)
+    })();
+    finish(app, r)?;
+    app.ui.mask_overlay = overlay;
+    Ok(())
+}
+
+/// Sponge Mode: remembered, and the mask in use follows (one undo step).
+pub fn set_sponge_mode(app: &mut LightcraftApp, mode: SpongeMode) -> Result<(), String> {
+    let old = app.ui.retouch.clone();
+    app.ui.retouch.sponge_mode = mode;
+    let Some((c, m)) = current_mask(app).filter(|(c, _)| c.tool == RetouchTool::Sponge) else { return Ok(()) };
+    let flow = m.adjust.saturation.abs().clamp(1.0, 100.0);
+    app.run("develop.beginInteraction", json!({"label": "Sponge"}))?;
+    let r = app
+        .run("mask.adjust", json!({"id": m.id, "values": {"saturation": mode.sign() * flow}}))
+        .and_then(|_| rename_if_automatic(app, &m, c.tool, &old));
+    finish(app, r)
+}
+
+/// End an interaction: committed when its steps all ran, cancelled otherwise.
+fn finish(app: &mut LightcraftApp, r: Result<(), String>) -> Result<(), String> {
+    match r {
+        Ok(()) => app.run("develop.endInteraction", json!({})).map(|_| ()),
+        Err(e) => {
+            let _ = app.run("develop.cancelInteraction", json!({}));
+            Err(e)
+        }
+    }
+}
+
+/// A mask still named as the tool named it follows its new range or mode; a name the user gave stays.
+fn rename_if_automatic(app: &mut LightcraftApp, m: &lightcraft_develop::Mask, tool: RetouchTool, old: &RetouchState) -> Result<(), String> {
+    if m.name == mask_name(tool, old) {
+        let name = mask_name(tool, &app.ui.retouch);
+        if name != m.name {
+            app.run("mask.rename", json!({"id": m.id, "name": name}))?;
+        }
+    }
+    Ok(())
+}
+
+// ------------------------------------------------------------------------ Clone Stamp source
+
+/// ⌥/Alt-click with Clone Stamp: the next strokes clone from `at` (normalized photo point).
+pub fn set_clone_source(app: &mut LightcraftApp, at: [f64; 2]) {
+    if let Some(photo) = app.session.active() {
+        app.ui.retouch.clone_source = Some(CloneSource { photo: photo.0, at, offset: None });
+    }
+}
+
+/// The source of the active photo's clone strokes, while the Clone mode is on.
+pub fn clone_source(app: &LightcraftApp) -> Option<CloneSource> {
+    let photo = app.session.active()?.0;
+    app.ui.retouch.clone_source.filter(|s| s.photo == photo && app.ui.tool == "clone")
+}
+
+/// The `source` offset of a clone stroke starting at `first`: from the set source to `first`;
+/// Aligned keeps the first stroke's offset for the next ones. `None`: no source set (the engine
+/// picks one).
+pub fn clone_offset(app: &mut LightcraftApp, first: [f64; 2]) -> Option<[f64; 2]> {
+    let src = clone_source(app)?;
+    let aligned = app.ui.retouch.clone_aligned;
+    if aligned && let Some(o) = src.offset {
+        return Some(o);
+    }
+    let o = [src.at[0] - first[0], src.at[1] - first[1]];
+    if aligned && let Some(s) = app.ui.retouch.clone_source.as_mut() {
+        s.offset = Some(o);
+    }
+    Some(o)
+}
