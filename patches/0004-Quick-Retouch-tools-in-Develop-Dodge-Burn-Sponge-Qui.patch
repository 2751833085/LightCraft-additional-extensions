+#[test]
+fn quick_mask_shows_a_red_overlay_with_the_brush_and_restores_the_overlay() {
+    let mut h = detail("panel.edit");
+    h.app.ui.mask_overlay = false;
+    h.app.ui.mask_overlay_mode = "colorOnBw".into();
+    h.app.ui.mask_overlay_color = [40, 200, 70];
+    h.app.ui.mask_overlay_opacity = 80.0;
+    let r = exec(&mut h, "tool.quickMask", json!({}));
+    assert_eq!(r["on"], true);
+    let d = develop(&h);
+    assert_eq!(d.masks.len(), 1, "with no mask selected, a brush mask to paint");
+    assert_eq!(d.masks[0].name, "Quick Mask");
+    assert_eq!((h.app.ui.right, h.app.ui.tool.as_str()), (RightPanel::Masking, "brush"));
+    assert!(h.app.ui.mask_overlay);
+    assert_eq!((h.app.ui.mask_overlay_mode.as_str(), h.app.ui.mask_overlay_color, h.app.ui.mask_overlay_opacity), ("color", [230, 30, 40], 50.0));
+    frames(&mut h);
+    assert!(h.app.ui.retouch.quick_mask.is_some());
+
+    let r = exec(&mut h, "tool.quickMask", json!({}));
+    assert_eq!(r["on"], false);
+    assert!(!h.app.ui.mask_overlay);
+    assert_eq!(
+        (h.app.ui.mask_overlay_mode.as_str(), h.app.ui.mask_overlay_color, h.app.ui.mask_overlay_opacity),
+        ("colorOnBw", [40, 200, 70], 80.0),
+        "the overlay as it was"
+    );
+    assert_eq!(develop(&h).masks.len(), 1, "the mask stays: it is the selection");
+
+    // Q again, with a mask selected: no new mask; the mask was one undo step
+    key(&mut h, "Q", false);
+    assert!(h.app.ui.retouch.quick_mask.is_some(), "Q turns Quick Mask on");
+    assert_eq!(develop(&h).masks.len(), 1);
+    key(&mut h, "Q", false);
+    assert!(h.app.ui.retouch.quick_mask.is_none(), "and off");
+    exec(&mut h, "edit.undo", json!({}));
+    assert!(develop(&h).masks.is_empty());
+}
