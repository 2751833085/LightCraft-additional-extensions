+#[test]
+fn retouch_keys_start_and_cycle_the_tools() {
+    let mut h = detail("panel.edit");
+    frames(&mut h);
+    key(&mut h, "B", true);
+    frames(&mut h);
+    assert_eq!(tool(&h), Some(RetouchTool::Dodge), "Shift+B starts Dodge");
+    key(&mut h, "B", true);
+    frames(&mut h);
+    assert_eq!(tool(&h), Some(RetouchTool::Burn), "then Burn");
+    key(&mut h, "B", true);
+    frames(&mut h);
+    assert_eq!(tool(&h), Some(RetouchTool::Sponge), "then Sponge");
+    let d = develop(&h);
+    assert_eq!(d.masks.iter().map(|m| (m.adjust.exposure, m.adjust.saturation)).collect::<Vec<_>>(), [(1.0, 0.0), (-1.0, 0.0), (0.0, -50.0)]);
+    key(&mut h, "B", true);
+    frames(&mut h);
+    assert_eq!(tool(&h), Some(RetouchTool::Dodge), "and round again");
+
+    key(&mut h, "W", true);
+    frames(&mut h);
+    assert_eq!(tool(&h), Some(RetouchTool::QuickSelect), "Shift+W: Quick Selection");
+    key(&mut h, "W", true);
+    frames(&mut h);
+    assert_eq!(h.app.ui.retouch.selection, RetouchTool::ObjectSelect, "then Object Selection");
+    assert!(!h.app.ui.brush_auto_mask, "Quick Selection's Auto Mask was given back");
+    h.app.ui.dialog = None;
+
+    key(&mut h, "Q", true);
+    assert_eq!((h.app.ui.right, h.app.ui.tool.as_str()), (RightPanel::Remove, "clone"), "Shift+Q: Clone Stamp");
+    key(&mut h, "Q", false);
+    assert!(h.app.ui.retouch.quick_mask.is_some(), "Q: Quick Mask");
+    assert_eq!(h.app.ui.right, RightPanel::Masking);
+
+    // with no other tool in use, the group's key starts the tool used last
+    exec(&mut h, "panel.edit", json!({}));
+    frames(&mut h);
+    key(&mut h, "B", true);
+    frames(&mut h);
+    assert_eq!(tool(&h), Some(RetouchTool::Dodge));
+}
